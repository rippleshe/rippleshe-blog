---
interface Props {
  latestPhoto?: { title: string; tags: string[] } | null;
  latestWord?: { title: string; kind: string; href: string } | null;
  counts: { words: number; photos: number; docs: number };
}
const { latestPhoto = null, latestWord = null, counts } = Astro.props;
---
<div class="seasonal-rails" data-seasonal-rails>
  <aside class="seasonal-rail seasonal-rail-left" aria-label="今日岁时与花草边景">
    <div class="season-wreath">
      <svg viewBox="0 0 160 520" preserveAspectRatio="none" aria-hidden="true">
        <path class="wreath-stem" d="M83 18c-24 78 24 129-4 201-25 64-8 126 15 185 15 39 9 74-12 98" />
        <path class="wreath-stem wreath-stem-b" d="M73 55c26 42 41 73 22 116M88 249c31 35 38 65 25 104" />
        <g class="wreath-leaves">
          <ellipse cx="63" cy="89" rx="12" ry="28" transform="rotate(-38 63 89)" />
          <ellipse cx="101" cy="135" rx="11" ry="26" transform="rotate(42 101 135)" />
          <ellipse cx="59" cy="205" rx="12" ry="29" transform="rotate(-47 59 205)" />
          <ellipse cx="108" cy="282" rx="12" ry="28" transform="rotate(48 108 282)" />
          <ellipse cx="66" cy="349" rx="10" ry="25" transform="rotate(-38 66 349)" />
          <ellipse cx="102" cy="414" rx="11" ry="27" transform="rotate(43 102 414)" />
        </g>
        <g class="wreath-buds">
          <circle cx="76" cy="56" r="5" /><circle cx="92" cy="176" r="4" /><circle cx="78" cy="315" r="4.5" /><circle cx="91" cy="456" r="4" />
        </g>
      </svg>
      <span class="wreath-dew dew-a"></span><span class="wreath-dew dew-b"></span><span class="wreath-dew dew-c"></span>
    </div>
    <div class="season-date-card">
      <small>SEASONAL FOLIO</small>
      <b id="rail-day">--</b>
      <span id="rail-weekday">星期 · --</span>
      <em id="rail-month">---- · ----</em>
      <span class="daily-botanical"><i id="rail-daily-symbol">叶</i><span id="rail-botanical">水边草木</span></span>
      <div class="year-water"><i></i><span id="rail-year-progress">0%</span></div>
      <p id="rail-daily-line">风从叶间来。</p>
    </div>
    <div class="season-counts">
      <span><b>{counts.words}</b>字</span><span><b>{counts.photos}</b>影</span><span><b>{counts.docs}</b>纸</span>
    </div>
  </aside>

  <aside class="seasonal-rail seasonal-rail-right" aria-label="水脉、此刻与最近内容">
    <div class="water-rill">
      <svg viewBox="0 0 160 620" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="rail-water" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#9bb5a7" stop-opacity=".08"/><stop offset=".5" stop-color="#6f9182" stop-opacity=".24"/><stop offset="1" stop-color="#496c61" stop-opacity=".06"/></linearGradient>
        </defs>
        <path class="rill-bed" d="M71 7c-12 66 18 108 3 169-16 65-20 116-3 170 19 60 18 112 0 172-9 31-9 63 2 95" />
        <path class="rill-flow rill-flow-a" d="M75 8c-10 69 21 105 5 169-16 64-18 116-1 168 19 59 16 113-2 174-8 28-8 59 3 92" />
        <path class="rill-flow rill-flow-b" d="M84 7c-9 62 15 101 1 168-12 59-14 113 3 166 18 56 13 114-5 178-7 25-5 57 4 90" />
        <g class="rill-fish fish-a" transform="translate(78 198)"><path d="M-16 0c8-9 22-9 31 0-8 9-23 9-31 0Z"/><path d="M-14 0l-12-8 3 8-3 8Z"/><circle cx="9" cy="-2" r="1.3"/></g>
        <g class="rill-fish fish-b" transform="translate(82 422) rotate(180)"><path d="M-13 0c7-8 19-8 27 0-7 8-20 8-27 0Z"/><path d="M-12 0l-10-7 3 7-3 7Z"/><circle cx="8" cy="-2" r="1.2"/></g>
        <g class="rill-leaves"><ellipse cx="57" cy="126" rx="20" ry="7"/><ellipse cx="96" cy="308" rx="22" ry="8"/><ellipse cx="55" cy="514" rx="18" ry="7"/></g>
        <g class="rill-wood"><path d="M103 72l46 6-6 56-46-6Z"/><path d="M99 132l44 6"/><path d="M102 100l44 6"/></g>
      </svg>
    </div>
    <div class="rill-copy">
      <small>WATER CALENDAR</small>
      <b id="rail-season">岁时</b>
      <time id="rail-time">--:--</time>
      <p id="rail-water-line">水慢慢走，日子也慢慢走。</p>
    </div>
    {latestPhoto && <a class="rail-echo rail-echo-photo" href="/collection/#photo-gallery-title"><small>最近一束光</small><b>{latestPhoto.title}</b><span>{latestPhoto.tags.slice(0,2).join(' · ')}</span></a>}
    {latestWord && <a class="rail-echo rail-echo-word" href={latestWord.href}><small>最近一行字</small><b>{latestWord.title}</b><span>{latestWord.kind}</span></a>}
  </aside>
</div>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-seasonal-rails]');
    if (!(root instanceof HTMLElement)) return;
    const weekdays = ['星期日','星期一','星期二','星期三','星期四','星期五','星期六'];
    const months = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
    const monthCn = ['一月','二月','三月','四月','五月','六月','七月','八月','九月','十月','十一月','十二月'];
    const lines = ['今天有雨，下在心坎上，干涸的心地上开出花。','河水追逐月亮，可月光一直在水里。','湿漉漉的心在雨季里生长。','有些句子，会把很久以前的日子一起带回来。','草木繁盛，人烟全无。','说过的话或许会留在过去里，可写下的文字却不会。','那瓶橙汁一直留在某个童年的午后。','满目何处不是我的世界。','花会盛开，我还会等待。','我从河水里拾起一块遍布坑洼的青石。','岁月升起无数次的日出，也挟走无数日落。','月亮是挂在我眼角的泪花。'];
    const waterLines = ['河水追逐月亮，可月光一直在水里。','今天有雨，下在大地上，也下在心坎上。','我很喜欢那种与水相融的感觉。','水边的日子，总会留下自己的页码。','光落在水里，也落进旧日子的缝隙。','那高悬穹顶的月亮，默然照着每个人的心里。','花期终究会过，水却还在向前。'];
    const seasonalPlants = [
      [{ symbol:'桂', label:'菌桂 · 冬枝' },{ symbol:'萝', label:'女萝 · 垂蔓' },{ symbol:'椒', label:'申椒 · 辛香' }],
      [{ symbol:'离', label:'江离 · 春佩' },{ symbol:'芷', label:'辟芷 · 新叶' },{ symbol:'兰', label:'秋兰 · 清佩' },{ symbol:'蕙', label:'蕙 · 百亩' },{ symbol:'夷', label:'留夷 · 芳畦' },{ symbol:'车', label:'揭车 · 清芬' },{ symbol:'衡', label:'杜衡 · 芳芷' },{ symbol:'若', label:'杜若 · 芳洲' }],
      [{ symbol:'荷', label:'芰荷 · 夏水' },{ symbol:'蓉', label:'芙蓉 · 水裳' },{ symbol:'荔', label:'薜荔 · 山藤' }],
      [{ symbol:'菊', label:'秋菊 · 落英' },{ symbol:'兰', label:'秋兰 · 晚香' },{ symbol:'莽', label:'宿莽 · 洲渚' },{ symbol:'兰', label:'木兰 · 朝露' }],
    ];
    const seasons = (m) => m >= 2 && m <= 4 ? '春水初生' : m >= 5 && m <= 7 ? '夏木清圆' : m >= 8 && m <= 10 ? '秋水有光' : '冬枝静影';
    const seasonIndex = (m) => m >= 2 && m <= 4 ? 1 : m >= 5 && m <= 7 ? 2 : m >= 8 && m <= 10 ? 3 : 0;
    const dayOfYear = (d) => Math.floor((Date.UTC(d.getFullYear(),d.getMonth(),d.getDate()) - Date.UTC(d.getFullYear(),0,0))/86400000);
    function paint() {
      const d = new Date();
      const doy = dayOfYear(d);
      const leap = new Date(d.getFullYear(),1,29).getMonth() === 1;
      const total = leap ? 366 : 365;
      const variant = doy % 7;
      root.dataset.daily = String(variant);
      root.style.setProperty('--daily-turn', `${(variant - 3) * 2.5}deg`);
      root.style.setProperty('--year-progress', `${(doy / total) * 100}%`);
      root.querySelector('#rail-day').textContent = String(d.getDate()).padStart(2,'0');
      root.querySelector('#rail-weekday').textContent = weekdays[d.getDay()];
      root.querySelector('#rail-month').textContent = `${monthCn[d.getMonth()]} · ${months[d.getMonth()]} ${d.getFullYear()}`;
      root.querySelector('#rail-year-progress').textContent = `${Math.round((doy / total) * 100)}%`;
      root.querySelector('#rail-daily-line').textContent = lines[doy % lines.length];
      const pool = seasonalPlants[seasonIndex(d.getMonth())];
      const plant = pool[doy % pool.length];
      root.querySelector('#rail-daily-symbol').textContent = plant.symbol;
      root.querySelector('#rail-botanical').textContent = plant.label;
      root.querySelector('#rail-season').textContent = seasons(d.getMonth());
      root.querySelector('#rail-time').textContent = `${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
      root.querySelector('#rail-water-line').textContent = waterLines[(doy + d.getMonth()) % waterLines.length];
    }
    paint();
    setInterval(paint, 60000);
    window.addEventListener('rippleshe:timechange', paint);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) paint(); });
  })();
</script>

<style>
  .seasonal-rails { position:absolute; inset:0; pointer-events:none; z-index:2; }
  .seasonal-rail { position:absolute; width:142px; color:var(--ink-soft); pointer-events:auto; }
  .seasonal-rail-left { left:-126px; top:166px; }
  .seasonal-rail-right { right:-126px; top:540px; }
  .season-wreath { height:455px; position:relative; overflow:visible; }
  .season-wreath svg,.water-rill svg { width:100%; height:100%; overflow:visible; }
  .wreath-stem { fill:none; stroke:rgba(63,86,65,.38); stroke-width:1.35; stroke-linecap:round; }
  .wreath-stem-b { opacity:.45; }
  .wreath-leaves ellipse { fill:rgba(125,146,120,.12); stroke:rgba(63,86,65,.42); stroke-width:1.1; transform-box:fill-box; transform-origin:center; }
  .wreath-buds circle { fill:rgba(139,78,67,.14); stroke:rgba(139,78,67,.38); stroke-width:.9; }
  .seasonal-rails[data-daily='1'] .wreath-leaves ellipse:nth-child(2n),.seasonal-rails[data-daily='4'] .wreath-leaves ellipse:nth-child(odd){ fill:rgba(139,78,67,.07); }
  .has-js .season-wreath svg { animation:wreath-breathe 12s ease-in-out infinite alternate; transform-origin:50% 86%; }
  .wreath-dew { position:absolute; width:5px; height:5px; border:1px solid rgba(85,117,107,.35); border-radius:50%; background:rgba(255,255,255,.22); box-shadow:0 2px 8px rgba(72,99,89,.08); }
  .dew-a{left:54px;top:103px}.dew-b{right:28px;top:263px}.dew-c{left:65px;top:373px}
  .has-js .wreath-dew { animation:dew-glint 7s ease-in-out infinite alternate; }.dew-b{animation-delay:-2s!important}.dew-c{animation-delay:-5s!important}
  .season-date-card { margin-top:-24px; padding:18px 8px 14px; border-top:1px solid var(--line-strong); border-bottom:1px solid var(--line); background:linear-gradient(180deg,rgba(248,245,237,.72),rgba(248,245,237,.18)); backdrop-filter:blur(3px); }
  .season-date-card small,.rill-copy small,.rail-echo small { display:block; color:var(--sage); font-size:6px; letter-spacing:.15em; }
  .season-date-card > b { display:block; margin:6px 0 0; color:var(--moss); font:400 56px/.92 var(--serif); letter-spacing:-.05em; }
  .season-date-card > span { display:block; color:var(--seal); font:9px/1.4 var(--serif); }
  .season-date-card > em { display:block; margin-top:6px; color:var(--mist); font:italic 8px/1.5 var(--serif); }
  .daily-botanical { margin-top:12px; min-height:34px; display:grid!important; grid-template-columns:30px 1fr; gap:7px; align-items:center; color:var(--ink-soft)!important; }
  .daily-botanical > i { width:29px; height:29px; display:grid; place-items:center; border:1px solid rgba(63,86,65,.16); border-radius:50%; color:var(--moss); font:400 15px var(--serif); font-style:normal; background:rgba(125,146,120,.04); }
  .daily-botanical > span { color:var(--mist); font:8px/1.45 var(--serif); }
  .season-date-card > p { margin:14px 0 0; color:var(--ink-soft); font:12px/1.7 var(--serif); }
  .year-water { margin-top:12px; display:grid; grid-template-columns:1fr auto; gap:7px; align-items:center; }.year-water i{height:2px;background:linear-gradient(90deg,var(--moss) 0 var(--year-progress),rgba(63,86,65,.08) var(--year-progress) 100%);border-radius:99px;position:relative;overflow:hidden}.year-water i::after{content:'';position:absolute;inset:0;background:repeating-linear-gradient(90deg,transparent 0 10px,rgba(248,245,237,.6) 10px 11px);animation:year-rill 10s linear infinite}.year-water span{color:var(--mist);font-size:6px}
  .season-counts { margin-top:16px; display:grid; grid-template-columns:repeat(3,1fr); gap:4px; }.season-counts span{display:grid;text-align:center;color:var(--mist);font-size:6px}.season-counts b{color:var(--moss);font:400 16px var(--serif)}
  .water-rill { height:560px; position:relative; }
  .rill-bed { fill:none; stroke:rgba(63,86,65,.08); stroke-width:18; stroke-linecap:round; }
  .rill-flow { fill:none; stroke:rgba(85,117,107,.36); stroke-width:1.4; stroke-linecap:round; stroke-dasharray:4 12; animation:rill-flow 13s linear infinite; }.rill-flow-b{opacity:.42;animation-duration:18s;animation-direction:reverse}
  .rill-fish { color:rgba(63,86,65,.62); transform-box:fill-box; transform-origin:center; }.rill-fish path{fill:rgba(63,86,65,.06);stroke:currentColor;stroke-width:1}.rill-fish circle{fill:var(--ink);opacity:.5}.has-js .fish-a{animation:rail-fish-a 14s ease-in-out infinite}.has-js .fish-b{animation:rail-fish-b 19s ease-in-out infinite -7s}
  .rill-leaves ellipse { fill:rgba(125,146,120,.18); stroke:rgba(63,86,65,.28); stroke-width:1; transform-box:fill-box; transform-origin:center; animation:rail-leaf 6s ease-in-out infinite alternate; }.rill-leaves ellipse:nth-child(2){animation-delay:-2s}.rill-leaves ellipse:nth-child(3){animation-delay:-4s}
  .rill-wood path{fill:rgba(149,124,94,.16);stroke:rgba(100,79,58,.28);stroke-width:1}
  .rill-copy { margin-top:-6px; padding:14px 8px; border-top:1px solid var(--line-strong); border-bottom:1px solid var(--line); background:rgba(248,245,237,.48); }
  .rill-copy b { display:block; margin:5px 0 2px; color:var(--moss); font:400 18px var(--serif); }.rill-copy time{color:var(--seal);font:10px var(--serif)}.rill-copy p{margin:11px 0 0;color:var(--ink-soft);font:11px/1.65 var(--serif)}
  .rail-echo { display:block; margin-top:20px; padding:12px 8px 13px; border-top:1px solid var(--line); transition:transform .25s ease,color .25s ease; }.rail-echo:hover{transform:translateX(-3px);color:var(--moss)}.rail-echo b{display:block;margin:7px 0 4px;font:400 12px/1.35 var(--serif)}.rail-echo span{color:var(--mist);font-size:6px;line-height:1.5}
  @keyframes wreath-breathe { from{transform:rotate(calc(var(--daily-turn) - 1deg)) translateY(1px)} to{transform:rotate(calc(var(--daily-turn) + 1deg)) translateY(-4px)} }
  @keyframes dew-glint { from{opacity:.18;transform:scale(.8)} to{opacity:.8;transform:scale(1.15)} }
  @keyframes year-rill { to{translate:22px 0} }
  @keyframes rill-flow { to{stroke-dashoffset:-120} }
  @keyframes rail-leaf { from{rotate:-2deg;translate:0 -1px} to{rotate:2deg;translate:2px 3px} }
  @keyframes rail-fish-a { 0%,100%{translate:0 -48px;rotate:-2deg} 45%{translate:8px 136px;rotate:4deg} 52%{translate:7px 148px;rotate:178deg} 94%{translate:0 -34px;rotate:183deg} }
  @keyframes rail-fish-b { 0%,100%{translate:0 74px;rotate:180deg} 45%{translate:-7px -112px;rotate:176deg} 53%{translate:-7px -122px;rotate:2deg} 94%{translate:0 61px;rotate:-2deg} }
  @media(min-width:1580px){.seasonal-rail{width:154px}.seasonal-rail-left{left:-178px}.seasonal-rail-right{right:-178px}.season-wreath{height:500px}.water-rill{height:590px}.season-date-card>b{font-size:58px}}
  @media(max-width:1430px){.seasonal-rail{width:112px}.seasonal-rail-left{left:-115px}.seasonal-rail-right{right:-115px}.season-wreath{height:390px}.water-rill{height:470px}.season-date-card>b{font-size:42px}}
  @media(max-width:1320px){.seasonal-rails{display:none}}
  @media(prefers-reduced-motion:reduce){.season-wreath svg,.wreath-dew,.rill-flow,.rill-fish,.rill-leaves ellipse,.year-water i::after{animation:none!important}}
</style>

---
type Place = 'garden' | 'collection' | 'works' | 'scenes' | 'about' | 'guestbook' | 'life';
interface Props { current: Place; }
const { current } = Astro.props;
const routes = {
  garden: [
    { href:'/collection/', eyebrow:'NEXT ROOM', title:'去藏册看光', note:'从字句走到照片与纸页。' },
    { href:'/life/', eyebrow:'TIME PATH', title:'沿时而行', note:'把文字、影像与文档按日期重新看一遍。' },
  ],
  collection: [
    { href:'/works/', eyebrow:'NEXT ROOM', title:'去看造物', note:'从保存下来的东西，走到真正做出来的东西。' },
    { href:'/life/', eyebrow:'TIME PATH', title:'沿时而行', note:'看看这些影像和文字在什么时候发生。' },
  ],
  works: [
    { href:'/scenes/', eyebrow:'SMALL SCENES', title:'去小景', note:'看那些不必成为项目、但值得玩的设计。' },
    { href:'/about/', eyebrow:'ABOUT THE MAKER', title:'去关于', note:'从作品回到做这些东西的人。' },
  ],
  scenes: [
    { href:'/garden/', eyebrow:'WORDS', title:'回芳洲', note:'从机关与水纹，回到写下来的东西。' },
    { href:'/about/', eyebrow:'THE PERSON', title:'去关于', note:'看看这些偏好从哪里长出来。' },
  ],
  about: [
    { href:'/now/', eyebrow:'SIDE GARDEN', title:'去此刻', note:'看最近正在发生什么。' },
    { href:'/guestbook/', eyebrow:'AT THE GATE', title:'去留字', note:'如果愿意，也在水边留一张笺。' },
  ],
  guestbook: [
    { href:'/garden/', eyebrow:'BACK INSIDE', title:'走进芳洲', note:'从来客簿回到园子里的文字。' },
    { href:'/', eyebrow:'GARDEN MAP', title:'回到园门', note:'重新看看整座园子的路。' },
  ],
  life: [
    { href:'/garden/', eyebrow:'WORDS', title:'按文字看', note:'回到芳洲，只看写下来的东西。' },
    { href:'/collection/', eyebrow:'LIGHT & PAPER', title:'按收藏看', note:'回到藏册，只看影像与纸页。' },
  ],
} as const;
const links = routes[current];
---
<nav class="garden-wayfinder" aria-label="从这里继续">
  <div class="wayfinder-title"><small>PATH / 从这里继续</small><span>园子没有唯一的走法。</span></div>
  <div class="wayfinder-links">
    {links.map((item, index) => (
      <a href={item.href}>
        <span>{String(index + 1).padStart(2,'0')}</span>
        <div><small>{item.eyebrow}</small><b>{item.title}</b><p>{item.note}</p></div>
        <i>↗</i>
      </a>
    ))}
  </div>
</nav>

<style>
.garden-wayfinder{margin:84px 0 24px;padding:24px 0 8px;border-top:1px solid var(--line-strong);display:grid;grid-template-columns:210px 1fr;gap:34px}.wayfinder-title{display:grid;align-content:start;gap:9px}.wayfinder-title small{color:var(--sage);font-size:7px;letter-spacing:.15em}.wayfinder-title span{font:14px/1.7 var(--serif);color:var(--mist)}.wayfinder-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-left:1px solid var(--line)}.wayfinder-links a{min-height:138px;padding:18px 20px;display:grid;grid-template-columns:28px 1fr 20px;gap:13px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:rgba(248,245,237,.16);transition:background .22s ease,transform .22s ease}.wayfinder-links a:hover{background:rgba(125,146,120,.06);transform:translateY(-2px)}.wayfinder-links>a>span{color:var(--seal);font:10px var(--serif)}.wayfinder-links small{display:block;color:var(--sage);font-size:6px;letter-spacing:.12em}.wayfinder-links b{display:block;margin:7px 0 6px;font:400 20px var(--serif);color:var(--ink)}.wayfinder-links p{margin:0;color:var(--mist);font:11px/1.6 var(--serif)}.wayfinder-links i{align-self:start;color:var(--mist);font-style:normal}.wayfinder-links a:hover i{color:var(--moss)}
@media(max-width:820px){.garden-wayfinder{grid-template-columns:1fr;gap:14px;margin-top:58px}.wayfinder-links{grid-template-columns:1fr}.wayfinder-links a{min-height:118px}}
</style>

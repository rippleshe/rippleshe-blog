---
type Place = 'garden' | 'collection' | 'works' | 'scenes' | 'about' | 'guestbook' | 'life';
interface Props { current: Place; }
const { current } = Astro.props;
const routes = {
  garden: [
    { href:'/collection/', eyebrow:'ARCHIVE', title:'图志藏册', note:'查看湖湘风物影像与文献档案。' },
    { href:'/life/', eyebrow:'TIMELINE', title:'岁时日录', note:'依年月岁序溯源文章与行迹。' },
  ],
  collection: [
    { href:'/works/', eyebrow:'ENGINEERING', title:'工程造物', note:'研制系统、开源工具与可视化框架。' },
    { href:'/life/', eyebrow:'TIMELINE', title:'岁时日录', note:'光影与文献的年月汇编。' },
  ],
  works: [
    { href:'/scenes/', eyebrow:'INTERACTIVE', title:'光景意象', note:'草木意象与物理模拟交互。' },
    { href:'/about/', eyebrow:'ETHOS', title:'人物小志', note:'学术背景、工程哲学与生平志。' },
  ],
  scenes: [
    { href:'/garden/', eyebrow:'WRITINGS', title:'芳洲文澜', note:'四十五篇古典诗词与文学随笔。' },
    { href:'/about/', eyebrow:'ETHOS', title:'人物小志', note:'立矩于器，寄怀于文。' },
  ],
  about: [
    { href:'/now/', eyebrow:'ACTIVITY', title:'此刻动向', note:'近期推进的研究与工程专案。' },
    { href:'/guestbook/', eyebrow:'GUESTBOOK', title:'水边留字', note:'访客登记、留言与思想回响。' },
  ],
  guestbook: [
    { href:'/garden/', eyebrow:'WRITINGS', title:'芳洲文澜', note:'启阅诗词、散文与行旅原篇。' },
    { href:'/', eyebrow:'PORTAL', title:'山门主轴', note:'返回主页与全站岁时罗盘。' },
  ],
  life: [
    { href:'/garden/', eyebrow:'WRITINGS', title:'芳洲文澜', note:'研读文学札记与诗章。' },
    { href:'/collection/', eyebrow:'ARCHIVE', title:'图志藏册', note:'检索光影定格与文献手稿。' },
  ],
} as const;
const links = routes[current];
---
<nav class="garden-wayfinder" aria-label="相关导览">
  <div class="wayfinder-title"><small>WAYFINDER · 畛域导览</small><span>循径漫步</span></div>
  <div class="wayfinder-links">
    {links.map((item, index) => (
      <a href={item.href}>
        <span>{String(index + 1).padStart(2,'0')}</span>
        <div><small>{item.eyebrow}</small><b>{item.title}</b><p>{item.note}</p></div>
        <i>↗</i>
      </a>
    ))}
  </div>
</nav>

<style>
.garden-wayfinder{margin:84px 0 24px;padding:24px 0 8px;border-top:1px solid var(--line-strong);display:grid;grid-template-columns:210px 1fr;gap:34px}.wayfinder-title{display:grid;align-content:start;gap:9px}.wayfinder-title small{color:var(--sage);font-size:var(--font-micro);letter-spacing:.12em}.wayfinder-title span{font:14px/1.7 var(--serif);color:var(--mist)}.wayfinder-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-left:1px solid var(--line)}.wayfinder-links a{min-height:118px;padding:16px 18px;display:grid;grid-template-columns:28px 1fr 20px;gap:12px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:rgba(248,245,237,.16);transition:background .22s ease,transform .22s ease}.wayfinder-links a:hover{background:rgba(125,146,120,.06);transform:translateY(-2px)}.wayfinder-links>a>span{color:var(--seal);font:11px var(--serif)}.wayfinder-links small{display:block;color:var(--sage);font-size:var(--font-micro);letter-spacing:.08em}.wayfinder-links b{display:block;margin:6px 0 4px;font:400 18px var(--serif);color:var(--ink)}.wayfinder-links p{margin:0;color:var(--mist);font:12px/1.5 var(--serif)}.wayfinder-links i{align-self:start;color:var(--mist);font-style:normal}.wayfinder-links a:hover i{color:var(--moss)}
@media(max-width:820px){.garden-wayfinder{grid-template-columns:1fr;gap:14px;margin-top:48px}.wayfinder-links{grid-template-columns:1fr}.wayfinder-links a{min-height:92px;padding:14px 16px}}
</style>

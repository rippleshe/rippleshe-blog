---
import ChuciGlyph from './ChuciGlyph.astro';

interface Props { path?: string; }
const currentPath = Astro.props.path ?? Astro.url.pathname;
const zone = currentPath.startsWith('/garden/') ? 'garden'
  : currentPath.startsWith('/collection/') ? 'collection'
  : currentPath.startsWith('/works/') ? 'works'
  : currentPath.startsWith('/guestbook') || currentPath.startsWith('/visitors') ? 'guestbook'
  : currentPath.startsWith('/scenes/') ? 'scenes'
  : currentPath.startsWith('/life/') ? 'life'
  : currentPath.startsWith('/about') || currentPath.startsWith('/now') || currentPath.startsWith('/uses') || currentPath.startsWith('/resume') ? 'about'
  : 'home';

const palettes = {
  home: ['lan','ruo'],
  garden: ['hui','vine'],
  collection: ['lotus','vine'],
  works: ['magnolia','pepper'],
  guestbook: ['ruo','vine'],
  scenes: ['vine','chrys'],
  life: ['ruo','lan'],
  about: ['ruo','lan'],
} as const;
type GlyphVariant = 'lan'|'ruo'|'lotus'|'vine'|'magnolia'|'pepper'|'chrys'|'hui';
const [leftVariant, rightVariant] = palettes[zone] as readonly GlyphVariant[];
---
<div class={`chuci-ambient chuci-zone-${zone}`} aria-hidden="true">
  <div class="chuci-edge chuci-edge-left"><ChuciGlyph variant={leftVariant} compact={true} class="ambient-glyph" /></div>
  <div class="chuci-edge chuci-edge-right"><ChuciGlyph variant={rightVariant} compact={true} class="ambient-glyph" /></div>
  <i class="chuci-ground chuci-ground-a"></i>
  <i class="chuci-ground chuci-ground-b"></i>
</div>

<style>
.chuci-ambient{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden;color:var(--moss);--ambient-opacity:.115}
.chuci-edge{position:absolute;top:116px;width:176px;height:min(64vh,610px);opacity:var(--ambient-opacity);mix-blend-mode:multiply}
.chuci-edge-left{left:max(4px,calc((100vw - 1180px)/2 - 188px))}
.chuci-edge-right{right:max(4px,calc((100vw - 1180px)/2 - 188px))}
.chuci-edge :global(.ambient-glyph){width:168px;opacity:1;transform-origin:center center}
.chuci-edge :global(.ambient-glyph svg){width:100%;height:auto;overflow:visible}
.chuci-edge-left :global(.ambient-glyph){transform:rotate(-2deg)}
.chuci-edge-right :global(.ambient-glyph){transform:rotate(3deg)}
.chuci-zone-works{--ambient-opacity:.085}.chuci-zone-collection{--ambient-opacity:.11}.chuci-zone-guestbook{--ambient-opacity:.13}.chuci-zone-scenes{--ambient-opacity:.095}.chuci-zone-garden{--ambient-opacity:.105}.chuci-zone-life{--ambient-opacity:.09}
.chuci-ground{position:absolute;bottom:24px;width:150px;height:42px;border-bottom:1px solid rgba(63,86,65,.12);border-radius:50%}
.chuci-ground-a{left:4vw;transform:rotate(-2deg)}.chuci-ground-b{right:5vw;transform:rotate(2deg)}
.has-js .chuci-edge-left :global(.ambient-glyph){animation:chuci-breathe-left 13s ease-in-out infinite alternate}
.has-js .chuci-edge-right :global(.ambient-glyph){animation:chuci-breathe-right 15s ease-in-out infinite alternate}
html[data-day-phase='dusk'] .chuci-ambient{filter:sepia(.05)}
html[data-day-phase='night'] .chuci-ambient{--ambient-opacity:.085;filter:saturate(.72)}
@keyframes chuci-breathe-left{from{translate:0 0;rotate:-.5deg}to{translate:0 -4px;rotate:.8deg}}
@keyframes chuci-breathe-right{from{translate:0 0;rotate:.6deg}to{translate:0 4px;rotate:-.8deg}}
@media(max-width:1450px){.chuci-edge{width:126px;opacity:.075}.chuci-edge-left{left:-42px}.chuci-edge-right{right:-38px}}
@media(max-width:1180px){.chuci-edge{display:none}.chuci-ground{opacity:.55}}
@media(prefers-reduced-motion:reduce){.chuci-edge :global(.ambient-glyph){animation:none!important}}
</style>

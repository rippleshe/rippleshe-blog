---
---
<section class="waterside-pond" data-water-garden aria-labelledby="waterside-pond-title">
  <div class="pond-note">
    <div>
      <p class="pond-kicker">WATER COURT · 水庭</p>
      <h2 id="waterside-pond-title">池上</h2>
      <p class="pond-line">风落下来时，鱼先知道。</p>
    </div>
    <div class="pond-index" aria-hidden="true">
      <span>R/S</span>
      <i></i>
      <small>04 · WATER</small>
    </div>
  </div>

  <div class="pond-stage" data-pond-stage role="img" aria-label="水边小景：水草、浮叶、木栈与缓缓游动的小鱼">
    <div class="pond-light" aria-hidden="true"></div>
    <svg class="pond-scene" viewBox="0 0 1200 520" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <linearGradient id="pond-water" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#dbe5d5" />
          <stop offset=".46" stop-color="#cfdccf" />
          <stop offset="1" stop-color="#b9cdbf" />
        </linearGradient>
        <linearGradient id="pond-deep" x1=".15" y1="0" x2=".9" y2="1">
          <stop offset="0" stop-color="#769188" stop-opacity=".05" />
          <stop offset="1" stop-color="#496c61" stop-opacity=".25" />
        </linearGradient>
        <linearGradient id="wood-wash" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#b99f7f" />
          <stop offset="1" stop-color="#8e765b" />
        </linearGradient>
        <filter id="pond-soft" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="8" />
        </filter>
      </defs>

      <path class="pond-water-shape" d="M20 108C112 38 260 19 420 43c117 18 201 6 300-10 176-29 355 5 441 95 52 54 48 149 6 211-52 77-165 123-321 128-160 6-254-35-388-18-148 18-286 37-378-10C2 399-23 311 13 238c30-61 42-97 7-130Z" fill="url(#pond-water)" />
      <path class="pond-deep" d="M77 235c148-94 280-98 420-54 115 37 192 27 299 3 121-27 252-11 351 47-48 89-153 144-311 151-158 8-252-34-390-13-141 22-266 30-347-16-50-28-60-73-22-118Z" fill="url(#pond-deep)" />

      <g class="water-lines">
        <path d="M124 183c107-32 196-28 290-5 86 21 164 17 258-3" />
        <path d="M223 311c95-20 184-16 284 9 116 29 203 13 323-18" />
        <path d="M531 120c85 11 142 8 219-7 88-17 175-12 245 10" />
        <path d="M682 391c79-17 146-14 225 2" />
      </g>

      <g class="branch-reflection">
        <path d="M790 58c68 35 125 80 175 143" />
        <path d="M842 91c-5 36-18 65-42 87" />
        <path d="M900 127c26-14 55-19 86-15" />
        <path d="M944 178c20-5 44-2 68 9" />
        <ellipse cx="801" cy="176" rx="13" ry="28" transform="rotate(42 801 176)" />
        <ellipse cx="985" cy="112" rx="12" ry="28" transform="rotate(76 985 112)" />
        <ellipse cx="1013" cy="187" rx="11" ry="26" transform="rotate(104 1013 187)" />
      </g>

      <g class="pond-stones">
        <ellipse cx="198" cy="406" rx="49" ry="18" />
        <ellipse cx="259" cy="430" rx="31" ry="12" />
        <ellipse cx="1050" cy="387" rx="42" ry="16" />
      </g>

      <g class="water-glints">
        <path d="M392 239h66" /><path d="M414 248h34" /><path d="M621 353h88" /><path d="M649 363h40" /><path d="M884 184h54" />
      </g>

      <g class="shore-grass shore-grass-left">
        <path d="M40 376c13-97 31-157 57-223" /><path d="M69 391c11-81 34-144 75-208" /><path d="M96 405c13-68 44-127 91-175" />
        <path d="M70 256c-24-30-37-55-41-78" /><path d="M99 228c21-34 41-58 62-70" /><path d="M128 283c29-22 56-34 80-36" />
        <ellipse cx="31" cy="176" rx="11" ry="25" transform="rotate(-25 31 176)" />
        <ellipse cx="159" cy="158" rx="10" ry="25" transform="rotate(38 159 158)" />
        <ellipse cx="206" cy="247" rx="9" ry="22" transform="rotate(67 206 247)" />
      </g>

      <g class="shore-grass shore-grass-right">
        <path d="M1115 424c-7-84-1-151 17-214" /><path d="M1143 427c-2-75 11-134 43-185" /><path d="M1085 416c1-63-10-115-29-154" />
        <path d="M1127 284c-25-23-44-48-53-72" /><path d="M1162 303c21-29 40-48 58-57" />
        <ellipse cx="1075" cy="211" rx="10" ry="24" transform="rotate(-39 1075 211)" />
        <ellipse cx="1216" cy="244" rx="10" ry="25" transform="rotate(42 1216 244)" />
      </g>

      <g class="pond-pads">
        <g class="pad pad-one"><ellipse cx="280" cy="230" rx="47" ry="20" /><path d="M280 230l31-12" /></g>
        <g class="pad pad-two"><ellipse cx="861" cy="270" rx="54" ry="22" /><path d="M861 270l34 9" /></g>
        <g class="pad pad-three"><ellipse cx="736" cy="130" rx="35" ry="15" /><path d="M736 130l20-9" /></g>
        <g class="tiny-flower" transform="translate(854 247)"><circle r="5" /><circle cx="8" cy="2" r="4" /><circle cx="4" cy="-7" r="4" /><circle cx="-5" cy="-5" r="4" /><circle cx="-7" cy="3" r="4" /></g>
      </g>

      <g class="wood-pier">
        <path class="wood-shadow" d="M910 42h283v72H910z" />
        <g class="wood-planks">
          <path d="M920 28l58 2-4 78-58-2Z" /><path d="M980 30l58 2-4 78-58-2Z" /><path d="M1040 32l58 2-4 78-58-2Z" /><path d="M1100 34l58 2-4 78-58-2Z" /><path d="M1160 36l43 2-4 78-43-2Z" />
        </g>
        <path class="wood-edge" d="M916 105l281 9" />
      </g>

      <g class="fish-anchor" transform="translate(355 332)">
        <g class="fish fish-one">
          <ellipse class="fish-wake" cx="-56" cy="0" rx="27" ry="8" /><ellipse class="fish-wake fish-wake-small" cx="-43" cy="0" rx="15" ry="4" />
          <path class="fish-body" d="M-37 0C-24-20 19-21 39 0 20 21-23 20-37 0Z" /><path class="fish-tail" d="M-34 0l-28-18 7 19-7 18Z" /><circle cx="24" cy="-4" r="2.3" />
        </g>
      </g>
      <g class="fish-anchor" transform="translate(730 214)">
        <g class="fish fish-two" transform="rotate(180)">
          <ellipse class="fish-wake" cx="-50" cy="0" rx="23" ry="7" /><ellipse class="fish-wake fish-wake-small" cx="-39" cy="0" rx="13" ry="4" />
          <path class="fish-body" d="M-32 0C-20-16 17-18 35 0 16 18-20 17-32 0Z" /><path class="fish-tail" d="M-29 0l-24-15 6 16-6 15Z" /><circle cx="21" cy="-3" r="2" />
        </g>
      </g>
      <g class="fish-anchor" transform="translate(552 132)">
        <g class="fish fish-three">
          <ellipse class="fish-wake" cx="-40" cy="0" rx="19" ry="6" />
          <path class="fish-body" d="M-25 0C-14-12 14-13 28 0 13 13-14 13-25 0Z" /><path class="fish-tail" d="M-23 0l-19-12 5 12-5 12Z" /><circle cx="17" cy="-3" r="1.8" />
        </g>
      </g>

      <g class="floating-petals">
        <path d="M488 88c10-10 22-8 25 3-8 8-18 10-25-3Z" /><path d="M963 345c8-9 18-8 21 2-6 8-14 10-21-2Z" /><path d="M604 411c9-8 20-5 20 6-8 6-16 6-20-6Z" />
      </g>
    </svg>

    <div class="pond-ripples" data-pond-ripples aria-hidden="true"></div>
    <div class="pond-corner-note" aria-hidden="true"><span>轻触水面</span><i></i></div>
  </div>
</section>

<script is:inline>
  (() => {
    const garden = document.querySelector('[data-water-garden]');
    const stage = garden?.querySelector('[data-pond-stage]');
    const ripples = garden?.querySelector('[data-pond-ripples]');
    if (!(garden instanceof HTMLElement) || !(stage instanceof HTMLElement) || !(ripples instanceof HTMLElement)) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const paintPhase = () => { garden.dataset.phase = document.documentElement.dataset.dayPhase || 'day'; };
    paintPhase();
    window.addEventListener('rippleshe:timechange', paintPhase);

    stage.addEventListener('pointermove', (event) => {
      if (reduceMotion.matches) return;
      const rect = stage.getBoundingClientRect();
      garden.style.setProperty('--pond-x', `${((event.clientX - rect.left) / rect.width) * 100}%`);
      garden.style.setProperty('--pond-y', `${((event.clientY - rect.top) / rect.height) * 100}%`);
    }, { passive: true });

    stage.addEventListener('pointerleave', () => {
      garden.style.setProperty('--pond-x', '53%');
      garden.style.setProperty('--pond-y', '35%');
    });

    stage.addEventListener('pointerdown', (event) => {
      if (reduceMotion.matches) return;
      const rect = stage.getBoundingClientRect();
      if (ripples.children.length > 8) ripples.firstElementChild?.remove();
      const ring = document.createElement('i');
      ring.style.left = `${event.clientX - rect.left}px`;
      ring.style.top = `${event.clientY - rect.top}px`;
      ripples.append(ring);
      ring.addEventListener('animationend', () => ring.remove(), { once: true });
      garden.dataset.awake = 'true';
      window.setTimeout(() => { garden.dataset.awake = 'false'; }, 1500);
    }, { passive: true });

    // 视口感知暂停，节约能耗
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        garden.dataset.inView = entry.isIntersecting ? 'true' : 'false';
      });
    }, { threshold: 0.1 });
    observer.observe(garden);
  })();
</script>

<style>
  .waterside-pond {
    --pond-x: 53%;
    --pond-y: 35%;
    --water-ink: #496c61;
    margin: 54px 0 86px;
    display: grid;
    grid-template-columns: minmax(170px, .34fr) minmax(0, 1.66fr);
    min-height: 390px;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line);
    position: relative;
    touch-action: pan-y;
  }
  .waterside-pond[data-in-view='false'] * {
    animation-play-state: paused !important;
  }
  .pond-note { padding: 42px 34px 32px 0; display:flex; flex-direction:column; justify-content:space-between; border-right:1px solid var(--line); }
  .pond-kicker { margin:0 0 12px; color:var(--sage); font-size:var(--font-micro); letter-spacing:.14em; }
  .pond-note h2 { margin:0; font:400 clamp(48px,7vw,84px)/.88 var(--serif); letter-spacing:-.06em; }
  .pond-line { margin:22px 0 0; max-width:10rem; color:var(--ink-soft); font:14px/1.85 var(--serif); }
  .pond-index { display:grid; grid-template-columns:auto 1fr; gap:8px 13px; align-items:center; color:var(--mist); font-size:var(--font-micro); letter-spacing:.12em; }
  .pond-index span { color:var(--seal); font-family:var(--serif); font-size:16px; letter-spacing:.02em; }
  .pond-index i { display:block; height:1px; background:linear-gradient(90deg,var(--line-strong),transparent); }
  .pond-index small { grid-column:1/-1; }
  .pond-stage { min-width:0; min-height:390px; overflow:hidden; position:relative; cursor:crosshair; isolation:isolate; background:rgba(206,219,207,.28); }
  .pond-stage::after { content:''; position:absolute; inset:0; z-index:6; pointer-events:none; box-shadow:inset 0 0 90px rgba(248,245,237,.35); background:linear-gradient(110deg,rgba(255,255,255,.12),transparent 42%,rgba(63,86,65,.025)); }
  .pond-scene { position:absolute; inset:0; width:100%; height:100%; overflow:visible; }
  .pond-light { position:absolute; z-index:4; inset:-20%; pointer-events:none; background:radial-gradient(circle at var(--pond-x) var(--pond-y),rgba(255,255,255,.34),rgba(255,255,255,.08) 12%,transparent 31%); mix-blend-mode:screen; transition:background-position .2s ease; }
  .pond-water-shape { filter:saturate(.78); }
  .pond-deep { opacity:.8; }
  .water-lines path { fill:none; stroke:rgba(255,255,255,.44); stroke-width:2; stroke-linecap:round; stroke-dasharray:4 18; animation:water-drift 14s linear infinite; }
  .water-lines path:nth-child(2){animation-duration:18s;animation-direction:reverse}.water-lines path:nth-child(3){animation-duration:21s}.water-lines path:nth-child(4){animation-duration:16s;animation-direction:reverse}
  .branch-reflection { fill:rgba(63,86,65,.045); stroke:rgba(63,86,65,.12); stroke-width:2; filter:blur(.25px); opacity:.8; transform-origin:950px 80px; animation:branch-shadow 12s ease-in-out infinite alternate; }
  .pond-stones ellipse { fill:rgba(108,109,91,.12); stroke:rgba(83,91,73,.17); stroke-width:1.2; }
  .water-glints path { fill:none; stroke:rgba(255,255,255,.62); stroke-width:2.2; stroke-linecap:round; opacity:.64; animation:glint 6s ease-in-out infinite alternate; }
  .water-glints path:nth-child(2n){animation-delay:-2.4s;opacity:.38}.water-glints path:nth-child(3n){animation-delay:-4s;animation-duration:8s}
  .shore-grass { fill:rgba(96,120,88,.2); stroke:rgba(63,86,65,.68); stroke-width:2; stroke-linecap:round; transform-box:fill-box; transform-origin:bottom center; animation:reed-sway 5.8s ease-in-out infinite alternate; }
  .shore-grass-right { animation-duration:7.2s; animation-delay:-2s; }
  .pond-pads ellipse { fill:rgba(98,127,94,.4); stroke:rgba(63,86,65,.42); stroke-width:1.5; }
  .pond-pads path { stroke:rgba(63,86,65,.35); fill:none; }
  .pad { transform-box:fill-box; transform-origin:center; animation:pad-drift 7s ease-in-out infinite alternate; }
  .pad-two { animation-duration:8.5s; animation-delay:-2s }.pad-three { animation-duration:6s; animation-delay:-1s }
  .tiny-flower circle { fill:rgba(248,245,237,.8); stroke:rgba(139,78,67,.32); stroke-width:1; }
  .wood-shadow { fill:rgba(63,86,65,.09); transform:translate(8px,10px); filter:url(#pond-soft); }
  .wood-planks path { fill:url(#wood-wash); stroke:rgba(81,70,53,.34); stroke-width:1; opacity:.76; }
  .wood-planks path:nth-child(odd){opacity:.64}.wood-edge{fill:none;stroke:rgba(81,70,53,.38);stroke-width:2}
  .fish { transform-box:fill-box; transform-origin:center; color:var(--water-ink); will-change:transform; }
  .fish-one { scale:1.16; }.fish-two { scale:1.12; }.fish-three { scale:1.04; }
  .fish-body { fill:rgba(76,104,95,.4); stroke:currentColor; stroke-width:2; }
  .fish-tail { fill:rgba(76,104,95,.23); stroke:currentColor; stroke-width:1.6; }
  .fish circle { fill:var(--ink); opacity:.82; }
  .fish-wake { fill:none; stroke:rgba(255,255,255,.42); stroke-width:1.3; opacity:.58; }
  .fish-wake-small { opacity:.34; }
  .fish-one { animation:fish-one 17s ease-in-out infinite; }
  .fish-two { color:rgba(139,78,67,.72); animation:fish-two 23s ease-in-out infinite; }
  .fish-three { opacity:.7; animation:fish-three 15s ease-in-out infinite; }
  .waterside-pond[data-awake='true'] .fish-one { animation-duration:8.5s; }
  .waterside-pond[data-awake='true'] .fish-two { animation-duration:11s; }
  .waterside-pond[data-awake='true'] .fish-three { animation-duration:7.5s; }
  .floating-petals path { fill:rgba(139,78,67,.28); animation:petal-float 8s ease-in-out infinite alternate; transform-box:fill-box; transform-origin:center; }
  .floating-petals path:nth-child(2){animation-delay:-3s;animation-duration:10s}.floating-petals path:nth-child(3){animation-delay:-1s;animation-duration:7s}
  .pond-ripples { position:absolute; inset:0; z-index:8; pointer-events:none; overflow:hidden; }
  .pond-ripples :global(i) { position:absolute; width:16px; height:6px; margin:-3px 0 0 -8px; border:1px solid rgba(63,86,65,.34); border-radius:50%; animation:pond-touch .95s cubic-bezier(.16,1,.3,1) forwards; }
  .pond-ripples :global(i)::after { content:''; position:absolute; inset:-4px -11px; border:1px solid rgba(125,146,120,.18); border-radius:50%; }
  .pond-corner-note { position:absolute; z-index:9; right:18px; bottom:15px; display:flex; align-items:center; gap:9px; color:rgba(63,86,65,.5); font-size:7px; letter-spacing:.14em; writing-mode:vertical-rl; }
  .pond-corner-note i { width:1px; height:28px; background:linear-gradient(var(--line-strong),transparent); }
  .waterside-pond[data-phase='dawn'] .pond-stage { filter:saturate(.85) sepia(.05); }
  .waterside-pond[data-phase='dusk'] .pond-stage { filter:saturate(.74) sepia(.12); }
  .waterside-pond[data-phase='night'] .pond-stage { filter:saturate(.62) brightness(.82) hue-rotate(6deg); }
  .waterside-pond[data-phase='night'] .pond-light { opacity:.45; }

  @keyframes water-drift { to { stroke-dashoffset:-110; } }
  @keyframes branch-shadow { from { transform:translate(-3px,0) rotate(-.5deg); opacity:.58; } to { transform:translate(5px,3px) rotate(1deg); opacity:.88; } }
  @keyframes glint { from { opacity:.2; transform:translateX(-4px); } to { opacity:.72; transform:translateX(8px); } }
  @keyframes reed-sway { from { transform:rotate(-1.6deg); } to { transform:rotate(2.2deg); } }
  @keyframes pad-drift { from { transform:translate(-3px,1px) rotate(-1deg); } to { transform:translate(5px,-2px) rotate(2deg); } }
  @keyframes petal-float { from { transform:translate(-2px,-2px) rotate(-5deg); } to { transform:translate(8px,6px) rotate(12deg); } }
  @keyframes fish-one { 0%,100%{transform:translate(-118px,8px) rotate(-4deg)} 46%{transform:translate(188px,-22px) rotate(3deg)} 52%{transform:translate(210px,-20px) rotate(176deg)} 96%{transform:translate(-94px,12px) rotate(184deg)} }
  @keyframes fish-two { 0%,100%{transform:translate(112px,-8px) rotate(180deg)} 44%{transform:translate(-158px,20px) rotate(177deg)} 52%{transform:translate(-178px,18px) rotate(2deg)} 94%{transform:translate(90px,-6px) rotate(-2deg)} }
  @keyframes fish-three { 0%,100%{transform:translate(-72px,-6px) rotate(-7deg)} 45%{transform:translate(118px,10px) rotate(7deg)} 53%{transform:translate(130px,12px) rotate(180deg)} 94%{transform:translate(-56px,-2px) rotate(186deg)} }
  @keyframes pond-touch { from { transform:scale(.45); opacity:.72 } to { transform:scale(11); opacity:0 } }

  @media (max-width: 820px) {
    .waterside-pond { grid-template-columns:1fr; margin:38px 0 66px; }
    .pond-note { min-height:120px; border-right:0; border-bottom:1px solid var(--line); padding:22px 0 18px; flex-direction:row; align-items:end; gap:20px; }
    .pond-note h2 { font-size:48px; }
    .pond-line { margin-top:10px; max-width:none; }
    .pond-index { width:118px; flex:0 0 auto; }
    .pond-stage { min-height:280px; }
    .wood-pier { opacity:.72; transform:translateX(34px); }
    .pond-corner-note { display:none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .water-lines path,.branch-reflection,.water-glints path,.shore-grass,.pad,.fish,.floating-petals path { animation:none !important; }
    .pond-light { display:none; }
  }
</style>

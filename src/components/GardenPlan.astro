---
const rooms = [
  { no:'01', href:'/garden/', name:'芳洲', en:'WORDS', note:'诗、小札、信和短文。写下来的东西都在这里生长。', side:'写' },
  { no:'02', href:'/collection/', name:'藏册', en:'LIGHT & PAPER', note:'照片、文档和愿意保存的纸页。这里负责收藏，而不是叙事。', side:'藏' },
  { no:'03', href:'/works/', name:'造物', en:'MADE THINGS', note:'真正做成的项目、工具与研究作品。完成度比花样更重要。', side:'作' },
  { no:'04', href:'/scenes/', name:'小景', en:'CURIOUS DESIGNS', note:'网页机关、动态小物、视觉实验。那些有趣但不必长成项目的设计。', side:'玩' },
  { no:'05', href:'/about/', name:'关于', en:'THE PERSON', note:'人本身，以及此刻、器物、履历三个侧院。', side:'人' },
  { no:'06', href:'/guestbook/', name:'留字', en:'GUESTBOOK', note:'来客从这里留下名字与一张笺。', side:'客' },
];
---
<section class="garden-plan" aria-labelledby="garden-plan-title">
  <header>
    <div><p class="eyebrow">Garden plan · 游园图</p><h2 id="garden-plan-title">这座园子，怎么走</h2></div>
    <p>首页只做园门。想读字、看照片、看项目、玩设计，走的是不同的路；想按时间重新浏览整座园子，则沿着下方那条水线走。</p>
  </header>
  <div class="garden-plan-grid">
    {rooms.map((room) => (
      <a href={room.href} class={`garden-plan-room garden-plan-room-${room.no}`}>
        <span class="garden-plan-no">{room.no}</span>
        <span class="garden-plan-side" aria-hidden="true">{room.side}</span>
        <div><small>{room.en}</small><b>{room.name}</b><p>{room.note}</p></div>
        <i>↗</i>
      </a>
    ))}
  </div>
  <a class="garden-time-path" href="/life/">
    <span>TIME PATH / 沿时而行</span>
    <i aria-hidden="true"><b></b><b></b><b></b></i>
    <strong>日录</strong>
    <p>不另存一份内容，只把芳洲、藏册里的东西按日期重新排成一条时间线。</p>
    <em>→</em>
  </a>
</section>

<style>
.garden-plan{padding:82px 0 72px;border-bottom:1px solid var(--line)}.garden-plan>header{display:grid;grid-template-columns:1fr minmax(310px,470px);gap:52px;align-items:end;margin-bottom:30px}.garden-plan h2{margin:7px 0 0;font:400 clamp(40px,5vw,62px)/.98 var(--serif);letter-spacing:-.04em}.garden-plan>header>p{margin:0;color:var(--ink-soft);font:14px/1.8 var(--serif)}.garden-plan-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--line-strong);border-left:1px solid var(--line)}.garden-plan-room{position:relative;min-height:190px;padding:18px 20px 18px 18px;display:grid;grid-template-columns:30px 1fr 18px;gap:12px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);overflow:hidden;transition:background .25s ease,transform .25s ease}.garden-plan-room:hover{background:rgba(125,146,120,.055);transform:translateY(-2px)}.garden-plan-no{color:var(--seal);font:10px var(--serif)}.garden-plan-side{position:absolute;right:13px;bottom:-9px;color:rgba(63,86,65,.045);font:400 70px var(--serif);transform:rotate(-4deg);pointer-events:none}.garden-plan-room small{color:var(--sage);font-size:6px;letter-spacing:.13em}.garden-plan-room b{display:block;margin:9px 0 7px;font:400 25px var(--serif)}.garden-plan-room p{margin:0;max-width:17rem;color:var(--mist);font:11px/1.7 var(--serif)}.garden-plan-room>i{color:var(--mist);font-style:normal}.garden-plan-room:hover>i{color:var(--moss)}.garden-time-path{margin-top:24px;min-height:90px;padding:17px 18px;display:grid;grid-template-columns:145px minmax(100px,1fr) 70px minmax(250px,420px) 24px;gap:18px;align-items:center;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:linear-gradient(90deg,rgba(85,117,107,.035),transparent);transition:background .22s ease}.garden-time-path:hover{background:rgba(85,117,107,.055)}.garden-time-path>span{color:var(--sage);font-size:7px;letter-spacing:.14em}.garden-time-path>i{display:flex;align-items:center;gap:15px;height:16px;position:relative}.garden-time-path>i::before{content:'';position:absolute;left:0;right:0;top:50%;height:1px;background:rgba(85,117,107,.2)}.garden-time-path>i b{position:relative;width:6px;height:6px;border:1px solid rgba(85,117,107,.35);border-radius:50%;background:var(--paper)}.garden-time-path strong{font:400 20px var(--serif)}.garden-time-path p{margin:0;color:var(--mist);font:11px/1.65 var(--serif)}.garden-time-path em{color:var(--moss);font-style:normal}
@media(max-width:900px){.garden-plan>header{grid-template-columns:1fr;gap:14px}.garden-plan-grid{grid-template-columns:repeat(2,1fr)}.garden-time-path{grid-template-columns:1fr 80px 60px 20px}.garden-time-path p{grid-column:1/-1}.garden-time-path>i{display:none}}
@media(max-width:560px){.garden-plan{padding:58px 0}.garden-plan-grid{grid-template-columns:1fr}.garden-plan-room{min-height:145px}.garden-time-path{grid-template-columns:1fr auto}.garden-time-path>span{grid-column:1}.garden-time-path strong{grid-column:1}.garden-time-path p{grid-column:1}.garden-time-path em{grid-column:2;grid-row:1/4}}
</style>

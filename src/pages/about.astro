---
import BaseLayout from '../layouts/BaseLayout.astro';
import BotanicalSprig from '../components/BotanicalSprig.astro';
import HerbDivider from '../components/HerbDivider.astro';
import PageFolioHeader from '../components/PageFolioHeader.astro';
import GardenWayfinder from '../components/GardenWayfinder.astro';
import ChuciGlyph from '../components/ChuciGlyph.astro';
---
<BaseLayout title="关于" description="关于 Rippleshe。个人生平、学术背景与技术追求。">
  <div class="shell folio-page about-page-v2">
    <PageFolioHeader
      eyebrow="Profile · 人物小志"
      title="关于"
      english="PROFILE & ETHOS OF RIPPLESHE"
      variant="ruo"
      folio="PERSON / RIPPLE · SHE"
      intro="波纹散开，行止有矩。以工程严谨构筑造物，以文心风骨寄怀天地。"
    />

    <HerbDivider label="人物生平与追求 · ethos" />

    <section class="portrait-notes" aria-labelledby="about-self">
      <aside class="portrait-index">
        <p>ENGINEER<br />RESEARCHER<br />WRITER<br />BUILDER</p>
        <BotanicalSprig variant="lan" />
        <ChuciGlyph variant="ruo" compact={true} class="about-chuci-ruo" />
      </aside>
      <div class="portrait-copy">
        <p class="portrait-lead" id="about-self">专注于科研可视化体系、系统级工具与决策智能体系统的工程与学术研究。</p>
        <div class="portrait-columns">
          <p>推崇精简求真的工程哲学：直面机理，摒弃冗余抽象与过度设计。从 SciPlot Academic 的顶刊绘图语法到各类系统应用，始终追求确定性、鲁棒性与清晰度。</p>
          <p>在算法与工程之外，长年记录湖湘山水、行旅诗篇与古典文学思考。文字与代码同为载体，一者澄明理性，一者安顿心性。</p>
        </div>
        <p>立足于真实的创造，于网络与现实世界中留下清晰、耐久的痕迹。</p>
      </div>
    </section>

    <section class="name-origin" aria-labelledby="name-origin-title">
      <div class="name-origin-head">
        <p class="eyebrow">Name origin · 名字渊源</p>
        <h2 id="name-origin-title">Rippleshe</h2>
        <p>英文名与汉字姓氏的交织。</p>
      </div>
      <div class="name-origin-grid">
        <div class="name-origin-ripple">
          <small>01 / RIPPLE</small>
          <strong>Ripple</strong>
          <p>波纹。取水面泛起之微澜，象征思想的扩散演化与自我审视的层层折返。</p>
          <div class="name-rings" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        </div>
        <div class="name-origin-she">
          <small>02 / SHE</small>
          <strong>佘</strong>
          <p>姓氏。人字立顶，示以行止之矩，作为现实锚点与行事之诺。</p>
        </div>
      </div>
    </section>

    <section class="about-index-cards" aria-label="核心领域索引">
      <a href="/now/" class="about-index-card">
        <small>01 / NOW</small>
        <b>此刻</b>
        <span>当下正在推进的研究课题、工程系统与近期动向。</span>
        <i>↗</i>
      </a>
      <a href="/scenes/" class="about-index-card">
        <small>02 / SCENES</small>
        <b>光景</b>
        <span>楚辞草木意象、互动流形与数字庭园设计。</span>
        <i>↗</i>
      </a>
    </section>

    <section class="about-contact-strip">
      <div>
        <p class="eyebrow">Elsewhere · 开源与学术网络</p>
        <strong>GitHub 源码与研制成果</strong>
      </div>
      <a class="rule-link" href="https://github.com/rippleshe" target="_blank" rel="noreferrer">访问 GitHub @rippleshe ↗</a>
    </section>
    <GardenWayfinder current="about" />
  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import BotanicalSprig from '../components/BotanicalSprig.astro';
import '../styles/guestbook.css';

const apiBase = import.meta.env.PUBLIC_GUESTBOOK_API || (import.meta.env.DEV ? 'http://127.0.0.1:4185' : '');
const edgeReady = Boolean(import.meta.env.CLOUDBASE_ENV_ID && import.meta.env.CLOUDBASE_PUBLISH_KEY);
const provider = import.meta.env.DEV ? 'local' : (edgeReady ? 'edgeone' : 'closed');
if (provider === 'closed') return Astro.redirect('/', 302);
---
<BaseLayout title="来客簿" description="Rippleshe 的私人来客簿。" noindex={true}>
  <div
    class="shell visitors-page"
    id="visitors-app"
    data-provider={provider}
    data-api-base={apiBase}
  >
    <header class="visitors-hero">
      <div>
        <p class="eyebrow">Private folio · 主人页</p>
        <h1>来客簿</h1>
        <p>这里不挂在院门口。只是给主人翻一翻：谁来过，叫什么名字，初见时说了什么，又留下过几张笺。</p>
      </div>
      <div class="visitors-key-card" id="visitors-key-card">
        {provider === 'local' ? (
          <>
            <label>主人钥匙<input id="visitors-owner-key" type="password" autocomplete="off" placeholder="••••••••••••" /></label>
            <button id="visitors-open" type="button">翻开来客簿</button>
          </>
        ) : (
          <>
            <label>主人邮箱<input id="visitors-owner-email" type="email" autocomplete="email" placeholder="you@example.com" /></label>
            <label id="visitors-owner-code-field" hidden>邮件验证码<input id="visitors-owner-code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" placeholder="6 位数字" /></label>
            <button id="visitors-open" type="button">寄一枚主人验证码</button>
            <button id="visitors-logout" type="button" hidden>合上来客簿</button>
          </>
        )}
        <p id="visitors-key-status"></p>
      </div>
    </header>

    <section class="visitors-dashboard" id="visitors-dashboard" hidden>
      <div class="visitors-summary">
        <span><b id="visitors-total">0</b><small>登记来客</small></span>
        <span><b id="visitors-notes">0</b><small>墙上留字</small></span>
      </div>

      <div class="visitors-register">
        <p class="eyebrow">Visitor register</p>
        <table class="visitors-table">
          <thead><tr><th>来客</th><th>邮箱</th><th>初见一句</th><th>登记</th><th>最近回来</th><th>留字</th><th></th></tr></thead>
          <tbody id="visitors-table-body"></tbody>
        </table>
      </div>

      <div class="owner-messages">
        <div class="guestbook-wall-head">
          <div><p class="eyebrow">Notes register</p><h2>墙上的字</h2></div>
          <p>这里保留更完整的来客信息。需要收走哪一张，直接在这里处理。</p>
        </div>
        <div id="owner-message-list"></div>
      </div>
    </section>

    <BotanicalSprig variant="lan" class="visitors-tail-herb" />
  </div>
  <script src="../scripts/visitors-client.ts"></script>
</BaseLayout>


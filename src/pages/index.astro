---
import BaseLayout from '../layouts/BaseLayout.astro';
import BotanicalSprig from '../components/BotanicalSprig.astro';
import GardenDrift from '../components/GardenDrift.astro';
import ChuciGlyph from '../components/ChuciGlyph.astro';
import site from '../data/site.json';

const dev = import.meta.env.DEV;
---
<BaseLayout>
  <div class="shell portal-page">
    <GardenDrift />

    <section class="portal-hero" aria-labelledby="portal-title">
      <div class="portal-copy">
        <div class="portal-meta-line">
          <span class="eyebrow">Private garden · Ripple / She</span>
          <div class="portal-clock"><time id="home-clock">--:--</time><time id="home-today">--.--</time></div>
        </div>

        <h1 id="portal-title">Ripple<em>she</em><i>。</i></h1>

        <div class="portal-manifesto">
          <p>{site.manifesto.map((line) => <span>{line}</span>)}</p>
        </div>

        <nav class="portal-actions" aria-label="从园门出发">
          <a class="garden-button garden-button-primary" href="/garden/"><span>01</span><b>走进芳洲</b><small>WORDS</small></a>
          <a class="garden-button" href="/collection/"><span>02</span><b>翻藏册</b><small>LIGHT & PAPER</small></a>
          <a class="garden-button" href="/works/"><span>03</span><b>看造物</b><small>MADE THINGS</small></a>
          <a class="garden-button" href="/scenes/"><span>04</span><b>逛小景</b><small>CURIOUS DESIGNS</small></a>
        </nav>

        {dev && (
          <a class="portal-owner-studio" href="http://127.0.0.1:4175#record" target="_blank" rel="noreferrer">
            <span>＋</span><b>添一页</b><small>LOCAL STUDIO</small>
          </a>
        )}

        <div class="portal-season-note">
          <b id="home-season">岁时</b>
          <p>门前的风每天不太一样。选一条路，慢慢往里走。</p>
        </div>
      </div>

      <div class="portal-bouquet" aria-hidden="true">
        <div class="bouquet-ripple"><i></i><i></i><i></i><i></i></div>
        <BotanicalSprig variant="lan" class="bouquet-lan" />
        <BotanicalSprig variant="ruo" class="bouquet-ruo" />
        <BotanicalSprig variant="hui" class="bouquet-hui" />
        <ChuciGlyph variant="ruo" compact={true} class="portal-chuci-mark" />
      </div>
    </section>

    <a class="portal-time-path" href="/life/" aria-label="沿时间浏览整座园子">
      <span class="portal-time-water" aria-hidden="true"><i></i><i></i><i></i></span>
      <div>
        <small>TIME PATH · 日录</small>
        <strong>沿水往回走</strong>
        <p>字、照片和纸页，会在各自的月份里重新碰面。</p>
      </div>
      <b>↗</b>
    </a>

    <div class="portal-closing">
      <BotanicalSprig variant="ruo" />
      <div>
        <p class="eyebrow">At the gate</p>
        <strong>先逛到这里。</strong>
        <p>下次再来，园里的东西大概又会挪动几寸。</p>
      </div>
    </div>
  </div>

  <script is:inline>
    function paintHomeClock() {
      const d = new Date();
      const m = d.getMonth() + 1;
      const seasons = m >= 3 && m <= 5 ? '春日芳菲' : m >= 6 && m <= 8 ? '夏木成荫' : m >= 9 && m <= 11 ? '秋草有香' : '冬枝静默';
      const clock = document.querySelector('#home-clock');
      const today = document.querySelector('#home-today');
      const season = document.querySelector('#home-season');
      if (clock) clock.textContent = `${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
      if (today) today.textContent = `${String(m).padStart(2,'0')}.${String(d.getDate()).padStart(2,'0')} / ${d.getFullYear()}`;
      if (season) season.textContent = seasons;
    }
    paintHomeClock();
    setInterval(paintHomeClock, 30000);
  </script>

  <style is:global>
    .portal-time-path{margin:54px 0 18px;min-height:152px;display:grid;grid-template-columns:minmax(180px,.58fr) 1fr 26px;gap:28px;align-items:center;padding:22px 4px;border-top:1px solid var(--line-strong);border-bottom:1px solid var(--line);transition:background .2s ease}
    .portal-time-path:hover{background:rgba(125,146,120,.035)}
    .portal-time-path>div small{display:block;color:var(--sage);font-size:7px;letter-spacing:.14em}.portal-time-path>div strong{display:block;margin:5px 0 7px;font:400 25px/1.2 var(--serif)}.portal-time-path>div p{margin:0;color:var(--mist);font:12px/1.7 var(--serif)}.portal-time-path>b{justify-self:end;color:var(--seal);font:400 18px var(--serif)}
    .portal-time-water{position:relative;height:58px;display:block;overflow:hidden}.portal-time-water i{position:absolute;left:3%;right:3%;height:1px;background:rgba(85,117,107,.26);border-radius:50%}.portal-time-water i:nth-child(1){top:16px;transform:rotate(-1deg)}.portal-time-water i:nth-child(2){top:29px;left:14%;right:7%;opacity:.7;transform:rotate(.7deg)}.portal-time-water i:nth-child(3){top:42px;left:8%;right:18%;opacity:.4;transform:rotate(-.4deg)}
    @media(max-width:760px){.portal-time-path{grid-template-columns:1fr 24px;gap:12px}.portal-time-water{grid-column:1/-1;height:34px}.portal-time-path>div{grid-column:1}.portal-time-path>b{grid-column:2;grid-row:2}}
  </style>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BotanicalSprig from '../../components/BotanicalSprig.astro';
import HerbDivider from '../../components/HerbDivider.astro';
import WatersidePond from '../../components/WatersidePond.astro';
import GardenWayfinder from '../../components/GardenWayfinder.astro';
import PoemScene from '../../components/PoemScene.astro';
import { getCollection } from 'astro:content';
import { gardenUrl, titleOf } from '../../lib/content';
const allGarden = await getCollection('garden', ({ data }) => data.publish);
const randomPages = allGarden.map(gardenUrl);
const scenePoem = allGarden.find((entry) => entry.data.kind === '诗' || entry.data.kind === '词');
---
<BaseLayout title="光景意象" description="水纹流形、风动枝叶与楚辞意象的交互设计。">
  <div class="shell scenes-page">
    <header class="scenes-hero">
      <div>
        <p class="eyebrow">Interactive Scenes · 光景意象</p>
        <h1>光景</h1>
        <p>东方草木意象、物理模拟与交互设计的交汇。汇聚水波流形、风动植物与诗意空间。</p>
      </div>
      <div class="scenes-herb" aria-hidden="true">
        <BotanicalSprig variant="lan" />
        <div class="scenes-rings"><i></i><i></i><i></i><i></i></div>
        <span>RIPPLE / WIND / LIGHT</span>
      </div>
    </header>

    <section class="scenes-index" aria-label="光景目录">
      <a href="#scene-water"><span>01</span><b>水庭</b><small>WAVE SIMULATION</small></a>
      <a href="#scene-wreath"><span>02</span><b>风环</b><small>ELASTIC SPRING</small></a>
      <a href="#scene-leaves"><span>03</span><b>拾遗</b><small>CHANCE & WORDS</small></a>
      <a href="#scene-poetry"><span>04</span><b>诗廊</b><small>POETIC SPACE</small></a>
    </section>

    <HerbDivider label="01 · 水庭 / wave simulation" />
    <div id="scene-water" class="scene-water"><WatersidePond /></div>

    <HerbDivider label="02 · 风环 / elastic spring" quiet={true} />
    <section id="scene-wreath" class="scene-wreath" data-wind-wreath>
      <div class="scene-copy"><p class="eyebrow">Wind wreath</p><h2>风动有律</h2><p>风场力学交互：兰若枝叶随指针受力偏转，依自然阻尼弹性复位。</p></div>
      <div class="wreath-stage" aria-label="会随指针轻微摆动的花环">
        <div class="wreath-ring"></div>
        <BotanicalSprig variant="lan" class="wreath-sprig wreath-sprig-a" />
        <BotanicalSprig variant="ruo" class="wreath-sprig wreath-sprig-b" />

      </div>
    </section>

    <HerbDivider label="03 · 拾遗 / chance & words" quiet={true} />
    <section id="scene-leaves" class="scene-leaves">
      <div class="scene-copy"><p class="eyebrow">Pick a leaf</p><h2>草木结契</h2><p>三种意象去向：偶得佳句、漫溯旧卷或凝眸片刻。</p></div>
      <div class="leaf-picks" data-leaf-picks>
        <button type="button" data-leaf="0"><i>叶</i><span>采兰</span></button>
        <button type="button" data-leaf="1"><i>芷</i><span>采芷</span></button>
        <button type="button" data-leaf="2"><i>苔</i><span>拾苔</span></button>
      </div>
      <div class="leaf-result" id="leaf-result" aria-live="polite">静待启阅。</div>
      <button class="scene-random-page" type="button" data-scene-random={JSON.stringify(randomPages)}>◇ 随机漫步旧卷</button>
    </section>

    <HerbDivider label="04 · 诗廊 / poetic space" quiet={true} />
    <section id="scene-poetry" class="scene-poetry">
      <div class="scene-copy"><p class="eyebrow">Poetry gallery</p><h2>诗意空间</h2><p>以视觉时空承载古典韵致，令文字与光晕、月影、雨滴共生。</p><a class="rule-link" href="/garden/poetry/">进入诗廊 ↗</a></div>
      <div class="scene-poetry-preview">
        {scenePoem && <PoemScene title={titleOf(scenePoem)} tags={scenePoem.data.tags} index={4} />}
        <small>{scenePoem ? titleOf(scenePoem) : '诗廊'}</small>
      </div>
    </section>

    <GardenWayfinder current="scenes" />
  </div>

  <script is:inline>
    (() => {
      const wreath = document.querySelector('[data-wind-wreath]');
      const stage = wreath?.querySelector('.wreath-stage');
      stage?.addEventListener('pointermove', (event) => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const rect = stage.getBoundingClientRect();
        const x = ((event.clientX - rect.left) / rect.width - .5) * 2;
        const y = ((event.clientY - rect.top) / rect.height - .5) * 2;
        wreath.style.setProperty('--wind-x', `${x * 5}deg`);
        wreath.style.setProperty('--wind-y', `${y * 4}px`);
      });
      stage?.addEventListener('pointerleave', () => { wreath.style.setProperty('--wind-x','0deg'); wreath.style.setProperty('--wind-y','0px'); });

      const leafLines = ['今天可以慢一点。','把一个没用的小念头留下来。','去水边——哪怕只是想象里的。'];
      document.querySelectorAll('[data-leaf]').forEach((button) => button.addEventListener('click', () => {
        const i = Number(button.dataset.leaf || 0);
        document.querySelector('#leaf-result').textContent = leafLines[i] || leafLines[0];
        document.querySelectorAll('[data-leaf]').forEach((item) => item.classList.toggle('is-picked', item === button));
      }));
      document.querySelector('[data-scene-random]')?.addEventListener('click', (event) => {
        const pages = JSON.parse(event.currentTarget.dataset.sceneRandom || '[]');
        if (pages.length) location.href = pages[Math.floor(Math.random()*pages.length)];
      });
    })();
  </script>
</BaseLayout>

<style>
.scenes-page{padding-top:34px}.scenes-hero{min-height:560px;display:grid;grid-template-columns:1fr .8fr;gap:70px;align-items:center;border-bottom:1px solid var(--line)}.scenes-hero h1{margin:6px 0 22px;font:400 clamp(78px,10vw,138px)/.82 var(--serif);letter-spacing:-.07em}.scenes-hero>div:first-child>p:last-child{max-width:42rem;color:var(--ink-soft);font:18px/1.8 var(--serif)}.scenes-herb{min-height:430px;position:relative;display:grid;place-items:center}.scenes-herb .botanical-sprig{width:260px;color:var(--moss);opacity:.42;transform:rotate(-9deg)}.scenes-rings{position:absolute;inset:50% auto auto 50%;width:300px;height:300px;transform:translate(-50%,-50%)}.scenes-rings i{position:absolute;inset:50%;border:1px solid rgba(85,117,107,.15);border-radius:50%;transform:translate(-50%,-50%)}.scenes-rings i:nth-child(1){width:110px;height:110px}.scenes-rings i:nth-child(2){width:170px;height:170px}.scenes-rings i:nth-child(3){width:230px;height:230px}.scenes-rings i:nth-child(4){width:290px;height:290px}.scenes-herb>span{position:absolute;right:15px;bottom:32px;color:var(--mist);font-size:7px;letter-spacing:.14em}.scenes-index{margin:32px 0 74px;display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line-strong);border-left:1px solid var(--line)}.scenes-index a{min-height:112px;padding:14px;display:grid;border-right:1px solid var(--line);border-bottom:1px solid var(--line);transition:background .2s ease}.scenes-index a:hover{background:rgba(125,146,120,.06)}.scenes-index span{color:var(--seal);font:9px var(--serif)}.scenes-index b{align-self:end;font:400 19px var(--serif)}.scenes-index small{color:var(--mist);font-size:6px;letter-spacing:.11em}.scene-water{margin-bottom:82px}.scene-wreath,.scene-leaves{padding:64px 0;display:grid;grid-template-columns:minmax(280px,.88fr) minmax(320px,1.12fr);gap:58px;align-items:center}.scene-copy h2{margin:7px 0 16px;font:400 clamp(38px,5vw,58px)/1 var(--serif);letter-spacing:-.035em}.scene-copy>p:last-child{max-width:34rem;color:var(--ink-soft);font:14px/1.8 var(--serif)}.wreath-stage{justify-self:center;width:min(330px,86%);aspect-ratio:1;position:relative;display:grid;place-items:center;transition:transform .35s ease;transform:translateY(var(--wind-y,0)) rotate(var(--wind-x,0deg))}.wreath-ring{position:absolute;width:66%;height:66%;border:1px solid rgba(63,86,65,.14);border-radius:50%;box-shadow:inset 0 0 0 28px rgba(125,146,120,.018)}.wreath-sprig{position:absolute;width:138px;color:var(--moss);opacity:.3;transition:transform .5s ease}.wreath-sprig-a{left:12%;top:20%;transform:rotate(calc(-54deg + var(--wind-x,0deg)))}.wreath-sprig-b{right:12%;top:25%;transform:rotate(calc(55deg + var(--wind-x,0deg)))}.scene-leaves{grid-template-columns:minmax(280px,.7fr) 1fr}.leaf-picks{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.leaf-picks button{min-height:190px;border:1px solid var(--line);background:rgba(248,245,237,.32);display:grid;place-items:center;align-content:center;gap:12px;color:var(--ink-soft);cursor:pointer;transition:transform .22s ease,background .22s ease}.leaf-picks button:hover,.leaf-picks button.is-picked{transform:translateY(-4px);background:rgba(125,146,120,.075)}.leaf-picks i{width:72px;height:96px;display:grid;place-items:center;border:1px solid rgba(63,86,65,.2);border-radius:70% 30% 65% 35%;transform:rotate(-13deg);font:400 22px var(--serif);font-style:normal;color:var(--moss)}.leaf-picks button:nth-child(2) i{transform:rotate(7deg);border-radius:35% 65% 38% 62%}.leaf-picks button:nth-child(3) i{transform:rotate(-2deg);border-radius:55% 45% 52% 48%}.leaf-picks span{font:12px var(--serif);color:var(--mist)}.leaf-result{grid-column:2;margin-top:-46px;padding:16px 18px;border-top:1px solid var(--line);font:17px/1.7 var(--serif);color:var(--ink-soft)}.scene-random-page{grid-column:2;justify-self:start;margin-top:10px;border:0;border-bottom:1px solid var(--line-strong);padding:8px 0;background:none;color:var(--moss);font:13px var(--serif);cursor:pointer}.scene-poetry{padding:78px 0;display:grid;grid-template-columns:minmax(280px,.78fr) minmax(360px,1.22fr);gap:70px;align-items:center}.scene-poetry .rule-link{display:inline-block;margin-top:18px}.scene-poetry-preview{min-height:360px;position:relative;display:grid;place-items:center;border:1px solid rgba(63,86,65,.13);background:linear-gradient(145deg,rgba(248,245,237,.42),rgba(222,231,220,.24));overflow:hidden}.scene-poetry-preview::before,.scene-poetry-preview::after{content:'';position:absolute;border:1px solid rgba(85,117,107,.11);border-radius:50%;pointer-events:none}.scene-poetry-preview::before{width:240px;height:240px;right:-96px;top:-112px}.scene-poetry-preview::after{width:150px;height:150px;left:-66px;bottom:-74px}.scene-poetry-preview :global(.poem-scene){width:min(520px,88%);height:auto;position:relative;z-index:1}.scene-poetry-preview>small{position:absolute;left:18px;bottom:15px;z-index:2;color:var(--mist);font:8px var(--serif);letter-spacing:.08em}
@media(max-width:850px){.scenes-hero{grid-template-columns:1fr;min-height:0;padding:60px 0}.scenes-herb{min-height:350px}.scenes-index{grid-template-columns:repeat(2,1fr)}.scene-wreath,.scene-leaves,.scene-poetry{grid-template-columns:1fr;gap:32px}.leaf-result,.scene-random-page{grid-column:1;margin-top:0}.scene-poetry-preview{min-height:300px}}
@media(max-width:560px){.scenes-index{grid-template-columns:1fr 1fr}.scenes-hero h1{font-size:82px}.wreath-stage{width:min(260px,78vw)}.wreath-sprig{width:108px}.leaf-picks{grid-template-columns:1fr}.leaf-picks button{min-height:130px;grid-template-columns:70px auto}.leaf-picks i{width:54px;height:70px}}
@media(prefers-reduced-motion:reduce){.wreath-stage,.wreath-sprig,.leaf-picks button{transition:none}}
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BotanicalSprig from '../../components/BotanicalSprig.astro';
import GardenWayfinder from '../../components/GardenWayfinder.astro';

const standards = [
  { journal: 'Nature / Springer', col1: '89 mm', col2: '183 mm', font: 'Helvetica / Arial (5–8 pt)', dpi: '1200 DPI 矢量', color: '感知均匀色系 · 色盲安全' },
  { journal: 'IEEE Transactions', col1: '3.5 in (88.9 mm)', col2: '7.16 in (181.8 mm)', font: 'Times New Roman (8–10 pt)', dpi: '600–1200 DPI', color: '灰度兼容 · 单色线型编码' },
  { journal: 'Science / AAAS', col1: '58.4 mm (1/3)', col2: '184.2 mm (全宽)', font: 'Helvetica (6–9 pt)', dpi: '1200 DPI 矢量', color: '极简无边框 · 强化数据墨水比' },
  { journal: 'Thesis / Monograph', col1: '140 mm', col2: '160 mm', font: '中英双语混合字体回退', dpi: '300–600 DPI', color: '典雅学术色系 · 支持双语标注' },
];

const chartFamilies = [
  {
    category: '分布与不确定性',
    en: 'Distribution & Uncertainty',
    charts: ['雨云图 (Raincloud)', '小提琴图 (Violin)', '山脊图 (Ridgeline)', '箱线分布 (Boxplot)', '边际分布 (Marginal)', '置信度带 (Confidence)'],
  },
  {
    category: '多维流向与拓扑',
    en: 'Flow, Hierarchy & Topology',
    charts: ['桑基图 (Sankey)', '旭日层级 (Sunburst)', '弦图 (Chord)', '网络拓扑 (Network Graph)', '打包气泡 (Packed Bubble)', '树状层级 (Treemap)'],
  },
  {
    category: '对比、时序与相关',
    en: 'Comparison & Dynamics',
    charts: ['高精度多线 (Multi-line)', '柱线双轴 (Combo)', '相关性热图 (Heatmap)', '3D 瀑布图 (Waterfall 3D)', '日历热图 (Calendar)', '雷达图 (Radar)'],
  },
  {
    category: '学术推断与模型诊断',
    en: 'Inference & Diagnostics',
    charts: ['火山图 (Volcano)', '泰勒图 (Taylor Diagram)', 'Bland-Altman 一致性', 'Q-Q 正态检验', '残差分布 (Residuals)', '主成分分析 (PCA)'],
  },
];

const gallery = [
  {
    id: '01',
    title: '多序列演化与置信边界',
    code: '01_multi_line.png',
    type: 'Multi-line & Confidence Interval',
    journal: 'Physical Review / IEEE',
    desc: '展示多组动态信号与收敛轨迹，主曲线与半透明置信区间带层叠，高对比度低饱和配色保证重叠可辨识性。',
  },
  {
    id: '19',
    title: '雨云图：多模态分布表征',
    code: '19_raincloud.png',
    type: 'Raincloud Plot (Half-Violin + Box + Jitter)',
    journal: 'Nature Methods / BioRxiv',
    desc: '融合半小提琴核密度估计、微型箱线图与原始数据点抖动，同时呈现数据总体分布形态与真实离散观测值。',
  },
  {
    id: '31',
    title: '高维能量与类别流动',
    code: '31_sankey.png',
    type: 'Sankey Diagram',
    journal: 'Applied Energy / Resources',
    desc: '精准呈现系统节点间的多阶段转移与损耗流向，节点宽度与连线弧度遵循流体力学几何平滑过渡。',
  },
  {
    id: '46',
    title: '多层级辐射与比例分解',
    code: '46_sunburst.png',
    type: 'Sunburst Radial Hierarchy',
    journal: 'Science Advances / Ecology',
    desc: '环形辐射几何结构，向外层层展开分类层级与权重分配，中心留白与径向文字角度保持极佳阅读体验。',
  },
];
---
<BaseLayout title="SciPlot Academic 科研绘图体系" description="面向国际顶刊的高精度科研绘图框架。遵循 Nature、Science、IEEE 等期刊严格出版规范。">
  <div class="shell sciplot-page-v2">
    <header class="sciplot-hero sciplot-hero-v2">
      <div class="sciplot-kicker-row">
        <a class="eyebrow back-link" href="/works/">← 回到造物研制录</a>
        <span class="sciplot-version-badge">VERSION 1.12.6 · PRODUCTION SPEC</span>
      </div>

      <div class="sciplot-title-group">
        <h1>SciPlot<br /><em>Academic</em></h1>
        <p class="sciplot-subtitle">面向国际顶刊的高精度科研可视化框架与出版级排版系统</p>
      </div>

      <div class="sciplot-stats-row">
        <div class="sciplot-stat-box">
          <span class="stat-num">45+</span>
          <span class="stat-label">图表家族体系</span>
        </div>
        <div class="sciplot-stat-box">
          <span class="stat-num">1200</span>
          <span class="stat-label">DPI 矢量渲染</span>
        </div>
        <div class="sciplot-stat-box">
          <span class="stat-num">4 大</span>
          <span class="stat-label">主流顶刊版式</span>
        </div>
        <div class="sciplot-stat-box">
          <span class="stat-num">0 配置</span>
          <span class="stat-label">声明式开箱即用</span>
        </div>
      </div>
    </header>

    <!-- 顶刊排版规范对比 -->
    <section class="sciplot-section" aria-labelledby="standards-heading">
      <div class="section-head">
        <small class="eyebrow">STANDARDS & PRESETS · 期刊版式规范</small>
        <h2 id="standards-heading">出版物级精准版面约束</h2>
        <p>学术发表要求严格的栏宽约束与可辨识度标准。SciPlot 将国际主流出版机构的物理尺寸与排版规范固化为底层引擎标准。</p>
      </div>

      <div class="standards-table-wrap">
        <table class="standards-table">
          <thead>
            <tr>
              <th>目标出版体系</th>
              <th>单栏宽度 (Single Column)</th>
              <th>双栏宽度 (Double Column)</th>
              <th>字体规范</th>
              <th>矢量分辨率与色彩</th>
            </tr>
          </thead>
          <tbody>
            {standards.map((s) => (
              <tr>
                <td><strong>{s.journal}</strong></td>
                <td><code>{s.col1}</code></td>
                <td><code>{s.col2}</code></td>
                <td>{s.font}</td>
                <td><small>{s.dpi} · {s.color}</small></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- 顶刊物理版面可视化标尺 -->
      <div class="manuscript-gauge-card">
        <div class="gauge-control-bar">
          <span class="gauge-label">LAYOUT SIMULATION · 论文排版实景模拟</span>
          <div class="gauge-buttons">
            <button type="button" class="gauge-btn active" data-col="single" data-width="89mm" data-journal="Nature (Single Column · 89mm)">Nature 单栏 (89mm)</button>
            <button type="button" class="gauge-btn" data-col="double" data-width="183mm" data-journal="Nature (Double Column · 183mm)">Nature 双栏 (183mm)</button>
            <button type="button" class="gauge-btn" data-col="single" data-width="88.9mm" data-journal="IEEE Trans (Single Column · 3.5 in)">IEEE 单栏 (3.5 in)</button>
          </div>
        </div>
        <div class="virtual-manuscript-paper">
          <div class="manuscript-head-lines">
            <div class="manuscript-title-line"></div>
            <div class="manuscript-author-line"></div>
          </div>
          <div class="virtual-columns-layout" id="virtual-layout-mode" data-mode="single">
            <div class="virtual-column">
              <p class="sim-text-line"></p><p class="sim-text-line"></p><p class="sim-text-line"></p>
              <div class="sim-figure-slot" id="sim-figure-target">
                <div class="sim-figure-graphic">
                  <span class="sim-graphic-tag" id="sim-gauge-tag">Nature 单栏 · 89 mm</span>
                  <img src="/media/works/sciplot/19_raincloud.png" alt="排版示意图" />
                </div>
                <caption class="sim-caption">Fig. 1 | Multimodal distribution of biomarkers across experimental groups.</caption>
              </div>
              <p class="sim-text-line"></p><p class="sim-text-line"></p><p class="sim-text-line"></p>
            </div>
            <div class="virtual-column">
              <p class="sim-text-line"></p><p class="sim-text-line"></p><p class="sim-text-line"></p><p class="sim-text-line"></p>
              <p class="sim-text-line"></p><p class="sim-text-line"></p><p class="sim-text-line"></p><p class="sim-text-line"></p>
              <p class="sim-text-line"></p><p class="sim-text-line"></p><p class="sim-text-line"></p><p class="sim-text-line"></p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 代码调用范式 -->
    <section class="sciplot-section" aria-labelledby="code-heading">
      <div class="section-head">
        <small class="eyebrow">DECLARATIVE API · 调用范式</small>
        <h2 id="code-heading">极简声明式代码流水线</h2>
        <p>告别反复微调 Matplotlib 底层参数的繁琐流程。以最少代码完成符合顶刊规范的图表生成与矢量导出。</p>
      </div>

      <div class="code-install-bar">
        <span class="install-label">QUICK INSTALL</span>
        <div class="install-tabs">
          <button type="button" class="install-tab active" data-cmd="pip install sciplot-academic">pip</button>
          <button type="button" class="install-tab" data-cmd="uv add sciplot-academic">uv</button>
          <button type="button" class="install-tab" data-cmd="conda install -c conda-forge sciplot">conda</button>
        </div>
        <div class="install-cmd-box">
          <code id="install-cmd-text">pip install sciplot-academic</code>
          <button type="button" class="copy-install-btn" title="复制安装命令">复制</button>
        </div>
      </div>

      <div class="code-showcase-box">
        <div class="code-box-header">
          <div class="code-dots"><i></i><i></i><i></i></div>
          <span>example_publication_figure.py</span>
          <button class="copy-code-btn" type="button" data-copy-target="#sciplot-demo-code">复制代码</button>
        </div>
        <pre><code id="sciplot-demo-code">import sciplot as sp
import pandas as pd

# 1. 一键载入目标期刊出版规范（栏宽、字号、边距、字体）
sp.set_style('nature', dpi=1200, font='helvetica')

# 2. 声明式生成专业级雨云图（支持核密度、微型箱线与散点抖动）
fig, ax = sp.plot_raincloud(
    data=df,
    x='treatment_group',
    y='biomarker_level',
    palette='muted_scientific',
    bandwidth=0.25,
    box_whisker=True,
    jitter=0.08
)

# 3. 添加出版级学术标注与显著性标识
sp.annotate_significance(ax, group1='Control', group2='Treated', p_val=0.001)

# 4. 导出为满足投稿标准的无损矢量 PDF
sp.save('figure1_multimodal.pdf')</code></pre>
      </div>
    </section>

    <!-- 45+ 家族分类矩阵 -->
    <section class="sciplot-section" aria-labelledby="spectrum-heading">
      <div class="section-head">
        <small class="eyebrow">CHART MATRIX · 45+ 图表家族谱系</small>
        <h2 id="spectrum-heading">覆盖全科研生命周期的图表库</h2>
        <p>系统化覆盖从探索性数据分析、模型收敛诊断到论文主图呈现的全维度学术可视化需求。</p>
      </div>

      <div class="matrix-filter-wrap">
        <input type="search" class="chart-matrix-filter" id="chart-matrix-filter" placeholder="检索 45+ 图表族（如：雨云、桑基、火山、PCA、瀑布…）" />
        <span class="matrix-filter-hint" id="matrix-filter-count">共 45+ 项全谱系</span>
      </div>

      <div class="families-grid" id="chart-families-grid">
        {chartFamilies.map((fam) => (
          <div class="family-card" data-category={fam.category}>
            <div class="family-head">
              <h3>{fam.category}</h3>
              <small>{fam.en}</small>
            </div>
            <ul class="family-list">
              {fam.charts.map((c) => (
                <li data-chart-name={c}><span>{c}</span></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- 感知均匀色彩科学体系 -->
    <section class="sciplot-section" aria-labelledby="palette-heading">
      <div class="section-head">
        <small class="eyebrow">COLOR SCIENCE · 感知色彩科学</small>
        <h2 id="palette-heading">出版级感知均匀与色盲安全色板</h2>
        <p>采用 CIELAB 与 CAM02-UCS 感知空间校准，确保灰度打印可读性与色觉障碍（CVD）友好。点击色块快速复制 HEX 代码。</p>
      </div>

      <div class="palettes-interactive-deck">
        <div class="palette-swatch-group">
          <div class="swatch-group-head">
            <strong>Nature Discrete</strong>
            <small>自然顶刊离散色系 · 6色</small>
          </div>
          <div class="swatch-strip">
            {['#3F5641', '#D17A6E', '#4B7285', '#C49A45', '#6B5B95', '#88B04B'].map(hex => (
              <button type="button" class="swatch-tile" style={`background-color: ${hex}`} data-copy-hex={hex} title={`复制 ${hex}`}>
                <span>{hex}</span>
              </button>
            ))}
          </div>
        </div>

        <div class="palette-swatch-group">
          <div class="swatch-group-head">
            <strong>Muted Scientific</strong>
            <small>低饱和学术对比色系 · 5色</small>
          </div>
          <div class="swatch-strip">
            {['#435343', '#8A5A4A', '#3B5B6D', '#9C7C38', '#5A6B7C'].map(hex => (
              <button type="button" class="swatch-tile" style={`background-color: ${hex}`} data-copy-hex={hex} title={`复制 ${hex}`}>
                <span>{hex}</span>
              </button>
            ))}
          </div>
        </div>

        <div class="palette-swatch-group">
          <div class="swatch-group-head">
            <strong>CMYK Press Safe</strong>
            <small>印刷四色油墨兼容 · 5色</small>
          </div>
          <div class="swatch-strip">
            {['#2E4057', '#048A81', '#F4D35E', '#EE964B', '#F95738'].map(hex => (
              <button type="button" class="swatch-tile" style={`background-color: ${hex}`} data-copy-hex={hex} title={`复制 ${hex}`}>
                <span>{hex}</span>
              </button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 实机案例画廊 -->
    <section class="sciplot-section" aria-labelledby="gallery-heading">
      <div class="section-head">
        <small class="eyebrow">GALLERY SPECIMENS · 出版级实图陈列</small>
        <h2 id="gallery-heading">真实学术渲染成果展示</h2>
        <p>以下示例图表均由 SciPlot 引擎原生渲染生成，满足 1200 DPI 矢量级输出精度。</p>
      </div>

      <div class="sciplot-specimens-grid">
        {gallery.map((item) => (
          <article
            class="specimen-card"
            data-lightbox
            data-lightbox-group="sciplot"
            data-lightbox-src={`/media/works/sciplot/${item.code}`}
            data-lightbox-title={item.title}
            data-lightbox-desc={item.desc}
            data-lightbox-meta={`${item.type} · ${item.journal}`}
            data-lightbox-seal="图"
          >
            <div class="specimen-image-wrap">
              <img src={`/media/works/sciplot/${item.code}`} alt={item.title} loading="lazy" />
              <div class="specimen-zoom-hint"><span>🔍 全屏放大检视</span></div>
              <div class="specimen-tag-bar">
                <span>{item.type}</span>
                <code>{item.journal}</code>
              </div>
            </div>
            <div class="specimen-content">
              <span class="specimen-id">PLATE {item.id}</span>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <footer class="sciplot-closing-box">
      <BotanicalSprig variant="ruo" />
      <div>
        <p class="eyebrow">System Philosophy</p>
        <strong>让科学数据拥有其本该具有的秩序与清晰度。</strong>
        <p>以工程标准化抹平繁琐参数，将科研人员的时间还给探索与发现本身。</p>
      </div>
      <a class="rule-link" href="/works/">返回造物研制录</a>
    </footer>

    <GardenWayfinder current="works" />
  </div>

  <script is:inline>
    // 复制代码
    document.querySelectorAll('.copy-code-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const target = document.querySelector(btn.dataset.copyTarget);
        if (!target) return;
        try {
          await navigator.clipboard.writeText(target.textContent);
          const orig = btn.textContent;
          btn.textContent = '已复制！';
          btn.style.color = 'var(--moss)';
          setTimeout(() => {
            btn.textContent = orig;
            btn.style.color = '';
          }, 2000);
        } catch (e) {
          console.error(e);
        }
      });
    });

    // 切换安装命令
    const tabs = document.querySelectorAll('.install-tab');
    const cmdText = document.getElementById('install-cmd-text');
    const copyInstall = document.querySelector('.copy-install-btn');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        if (cmdText) cmdText.textContent = tab.dataset.cmd || '';
      });
    });

    // 切换论文版面单双栏模拟
    const gaugeBtns = document.querySelectorAll('.gauge-btn');
    const layoutMode = document.getElementById('virtual-layout-mode');
    const gaugeTag = document.getElementById('sim-gauge-tag');
    gaugeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        gaugeBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        if (layoutMode) layoutMode.dataset.mode = btn.dataset.col || 'single';
        if (gaugeTag) gaugeTag.textContent = btn.dataset.journal || '';
      });
    });

    // 复制色板 HEX
    document.querySelectorAll('[data-copy-hex]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const hex = btn.dataset.copyHex;
        if (!hex) return;
        try {
          await navigator.clipboard.writeText(hex);
          const span = btn.querySelector('span');
          if (span) {
            const orig = span.textContent;
            span.textContent = 'COPIED';
            setTimeout(() => { span.textContent = orig; }, 1500);
          }
        } catch (e) {
          console.error(e);
        }
      });
    });

    // 45+ 图表家族实时检索过滤
    const matrixInput = document.getElementById('chart-matrix-filter');
    const matrixCount = document.getElementById('matrix-filter-count');
    const chartItems = document.querySelectorAll('#chart-families-grid li');
    const familyCards = document.querySelectorAll('#chart-families-grid .family-card');

    matrixInput?.addEventListener('input', () => {
      const q = matrixInput.value.trim().toLowerCase();
      let matchedCount = 0;

      chartItems.forEach(li => {
        const name = (li.dataset.chartName || li.textContent || '').toLowerCase();
        const matched = !q || name.includes(q);
        li.style.display = matched ? '' : 'none';
        li.style.color = q && matched ? 'var(--moss)' : '';
        li.style.fontWeight = q && matched ? '600' : '';
        if (matched) matchedCount += 1;
      });

      familyCards.forEach(card => {
        const hasVisible = card.querySelector('li:not([style*="display: none"])');
        card.style.display = hasVisible ? '' : 'none';
      });

      if (matrixCount) {
        matrixCount.textContent = q ? `匹配到 ${matchedCount} 种图表` : '共 45+ 项全谱系';
      }
    });

    copyInstall?.addEventListener('click', async () => {
      if (!cmdText) return;
      try {
        await navigator.clipboard.writeText(cmdText.textContent);
        const orig = copyInstall.textContent;
        copyInstall.textContent = '已复制！';
        setTimeout(() => { copyInstall.textContent = orig; }, 2000);
      } catch (e) {
        console.error(e);
      }
    });
  </script>
</BaseLayout>

<style>
  .sciplot-page-v2 {
    padding-top: 36px;
    padding-bottom: 72px;
  }
  .sciplot-kicker-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    flex-wrap: wrap;
    gap: 12px;
  }
  .sciplot-version-badge {
    font-size: 10px;
    letter-spacing: 0.08em;
    padding: 3px 8px;
    background: rgba(125, 146, 120, 0.15);
    border: 1px solid var(--line);
    color: var(--moss);
    font-family: var(--sans);
  }
  .sciplot-title-group h1 {
    font-size: clamp(38px, 6vw, 56px);
    line-height: 1.05;
    margin: 0;
    font-family: var(--serif);
    letter-spacing: -0.03em;
  }
  .sciplot-title-group h1 em {
    font-style: italic;
    font-weight: 300;
    color: var(--moss);
  }
  .sciplot-subtitle {
    font-size: 16px;
    color: var(--ink);
    opacity: 0.85;
    margin: 12px 0 28px;
    max-width: 680px;
    line-height: 1.6;
  }
  .sciplot-stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    padding: 20px 0;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    margin-bottom: 48px;
  }
  .sciplot-stat-box {
    display: flex;
    flex-direction: column;
  }
  .stat-num {
    font-size: 28px;
    font-family: var(--serif);
    color: var(--moss);
    line-height: 1.1;
  }
  .stat-label {
    font-size: 11px;
    color: var(--mist);

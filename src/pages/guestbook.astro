---
import BaseLayout from '../layouts/BaseLayout.astro';
import BotanicalSprig from '../components/BotanicalSprig.astro';
import HerbDivider from '../components/HerbDivider.astro';
import GardenWayfinder from '../components/GardenWayfinder.astro';
import ChuciGlyph from '../components/ChuciGlyph.astro';
import '../styles/guestbook.css';

const apiBase = import.meta.env.PUBLIC_GUESTBOOK_API || (import.meta.env.DEV ? 'http://127.0.0.1:4185' : '');
const edgeReady = Boolean(import.meta.env.CLOUDBASE_ENV_ID && import.meta.env.CLOUDBASE_PUBLISH_KEY);
const guestbookProvider = import.meta.env.DEV ? 'local' : (edgeReady ? 'edgeone' : 'closed');
---
<BaseLayout title="留字客册" description="芳洲来客簿。留名、寄语与思想共鸣。">
  <div
    class="shell guestbook-page-v3"
    id="guestbook-app"
    data-provider={guestbookProvider}
    data-api-base={apiBase}
  >
    <header class="guestbook-hero guestbook-hero-v3">
      <div class="guestbook-title-side">
        <p class="eyebrow">Guestbook · 水边来客簿</p>
        <h1>留字</h1>
        <p class="guestbook-english">A NOTE LEFT BY THE WATER</p>
        <div class="guestbook-counts" aria-label="来客簿计数">
          <span><b id="guestbook-visitor-count">—</b><small>来客</small></span>
          <i></i>
          <span><b id="guestbook-message-count">—</b><small>留字</small></span>
        </div>
      </div>
      <div class="guestbook-intro guestbook-intro-v3">
        <BotanicalSprig variant="lan" class="guestbook-herb" />
        <BotanicalSprig variant="hui" class="guestbook-herb guestbook-herb-small" />
        <span class="guestbook-door-no">R/S · 04</span>
        <p>水边来客，留墨存痕。以邮箱安全登记凭据，往来信步，皆有回响。</p>
        <small>SECURE AUTH · IDENTITY & GUEST NOTES</small>
        <div class="guestbook-rings" aria-hidden="true"><i></i><i></i><i></i></div>
      </div>
    </header>

    <HerbDivider label="访客鉴权与留墨 · visitor authentication" />

    <section class="guestbook-entry" aria-labelledby="guestbook-entry-title">
      <aside class="guestbook-entry-aside">
        <div class="guestbook-pass guestbook-pass-a">
          <span>VISITOR PASS</span>
          <b>客</b>
          <small>水木清华，<br />过客留名。</small>
        </div>
        <div class="guestbook-pass guestbook-pass-b" aria-hidden="true">
          <span>RIPPLE / SHE</span>
          <p>微澜初泛。<br />见字如面。</p>
        </div>
        <BotanicalSprig variant="ruo" class="guestbook-side-herb" />
        <ChuciGlyph variant="vine" compact={true} class="guestbook-chuci-vine" />
      </aside>

      <div class="guestbook-entry-main">
        <div class="guestbook-entry-head">
          <div><p class="eyebrow">Visitor authentication</p><h2 id="guestbook-entry-title">访客凭据登记</h2></div>
          <span id="guestbook-session-mark">GUEST / UNKNOWN</span>
        </div>

        <div id="guestbook-signed-out" class="guestbook-signed-out">
          <p>支持邮箱验证码安全注册与登录。公开留墨墙仅展示昵称，保护访客隐私。</p>
          <div class="guestbook-entry-actions">
            <button class="guestbook-primary" id="guestbook-register-open" type="button">访客登记 · 注册</button>
            <button class="guestbook-secondary" id="guestbook-login-open" type="button">故友重访 · 登录</button>
          </div>
          <small>邮箱仅用于身份验证，严守安全边界，不在公开墙体呈现。</small>
        </div>

        <div id="guestbook-signed-in" class="guestbook-signed-in" hidden>
          <div class="guestbook-profile-strip">
            <span class="guestbook-avatar" id="guestbook-avatar">R</span>
            <div><small>WELCOME BACK</small><b id="guestbook-profile-name">来客</b><p id="guestbook-profile-greeting"></p></div>
            <button id="guestbook-logout" type="button">退出登录</button>
          </div>
          <form id="guestbook-message-form" class="guestbook-composer">
            <label for="guestbook-message">留言寄语</label>
            <textarea id="guestbook-message" name="message" maxlength="600" rows="5" placeholder="写下一句问候、思想共鸣或行旅见闻…"></textarea>
            <div><span id="guestbook-message-status">随时可落墨。</span><button class="guestbook-primary" type="submit">发布留言</button></div>
          </form>
        </div>
      </div>
    </section>

    <section class="guestbook-wall-section" aria-labelledby="guestbook-wall-title">
      <div class="guestbook-wall-head">
        <div><p class="eyebrow">Public guest wall · 留墨墙</p><h2 id="guestbook-wall-title">往来留墨</h2></div>
        <p>如水上浮笺，汇存四方来客的问候与见闻。</p>
      </div>
      <div class="guestbook-wall" id="guestbook-wall" aria-live="polite">
        <div class="guestbook-wall-empty guestbook-wall-awaiting">
          <div class="guestbook-awaiting-slip guestbook-awaiting-slip-1"><small>WALL / 01</small><p>墨痕待染。</p><i></i></div>
          <div class="guestbook-awaiting-slip guestbook-awaiting-slip-2"><small>WALL / 02</small><p>静候访客留言。</p><i></i></div>
          <div class="guestbook-awaiting-slip guestbook-awaiting-slip-3"><small>WALL / 03</small><p>见字如面。</p><i></i></div>
          <span class="guestbook-awaiting-caption">虚席以待，静候来客。</span>
        </div>
      </div>
      <div class="guestbook-wall-tail" aria-hidden="true"><span>R/S</span><i></i><small>someone was here</small></div>
    </section>

    <GardenWayfinder current="guestbook" />

    <dialog class="guestbook-auth" id="guestbook-auth-dialog">
      <div class="guestbook-auth-sheet">
        <button class="guestbook-auth-close" id="guestbook-auth-close" type="button" aria-label="关闭">×</button>
        <div class="guestbook-auth-title">
          <span class="seal-mark">客</span>
          <div><p class="eyebrow">Visitor registry</p><h2 id="guestbook-auth-heading">来客登记</h2><small>RIPPLESHE · WATER-SIDE REGISTER</small></div>
        </div>

        <div class="guestbook-auth-tabs" role="tablist">
          <button id="guestbook-tab-register" type="button" class="active">第一次来</button>
          <button id="guestbook-tab-login" type="button">已经来过</button>
        </div>

        <form id="guestbook-register-form" class="guestbook-auth-form">
          <label><span>邮箱</span><input name="email" type="email" autocomplete="email" required placeholder="you@example.com" /></label>
          {guestbookProvider === 'edgeone' && <label data-code-field hidden><span>邮件验证码</span><input name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" placeholder="6 位数字" /></label>}
          <div class="guestbook-auth-pair">
            <label><span>用户名</span><input name="username" type="text" minlength="2" maxlength="24" autocomplete="username" required placeholder="你的门牌" /></label>
            <label><span>昵称</span><input name="nickname" type="text" maxlength="30" required placeholder="想被怎样称呼" /></label>
          </div>
          <label><span>初见的一句话 <small>optional</small></span><input name="greeting" type="text" maxlength="80" placeholder="比如：今天风很好。" /></label>
          {guestbookProvider !== 'closed' && <label data-password-field><span>密码</span><input name="password" type="password" minlength="8" maxlength="64" autocomplete="new-password" required placeholder="至少 8 个字符，包含字母和数字" /></label>}
          <p class="guestbook-auth-status" id="guestbook-register-status"></p>
          <button class="guestbook-primary" type="submit">把名字写进来客簿</button>
        </form>

        <form id="guestbook-login-form" class="guestbook-auth-form" hidden>
          <label><span>邮箱</span><input name="email" type="email" autocomplete="email" required placeholder="you@example.com" /></label>
          {guestbookProvider !== 'closed' && <label data-password-field><span>密码</span><input name="password" type="password" minlength="8" maxlength="64" autocomplete="current-password" required /></label>}
          <p class="guestbook-auth-status" id="guestbook-login-status"></p>
          <button class="guestbook-primary" type="submit">回来这一页</button>
        </form>
      </div>
    </dialog>
  </div>
  <script src="../scripts/guestbook-client.ts"></script>
</BaseLayout>


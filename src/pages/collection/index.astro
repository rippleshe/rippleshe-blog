---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BotanicalSprig from '../../components/BotanicalSprig.astro';
import HerbDivider from '../../components/HerbDivider.astro';
import GardenWayfinder from '../../components/GardenWayfinder.astro';
import ChuciGlyph from '../../components/ChuciGlyph.astro';
import { galleryPhotos as photos, documents, formatLibraryDate } from '../../lib/library';
const dev = import.meta.env.DEV;
const fallbackGallerySizes = ['wide', 'narrow', 'standard', 'narrow', 'wide', 'standard', 'standard'] as const;
const galleryRatioOf = (item: (typeof photos)[number]) => {
  if (item.galleryRatio) return item.galleryRatio;
  const ratio = item.width && item.height ? item.width / item.height : 1;
  return ratio > 1.8 ? 'cinematic' : ratio > 1.12 ? 'landscape' : ratio < .82 ? 'portrait' : 'square';
};
---
<BaseLayout title="藏册" description="照片、文档与愿意留下来的东西。">
  <div class="shell collection-page">
    <header class="collection-hero">
      <div>
        <p class="eyebrow">Collected matter · archive room</p>
        <h1>藏册</h1>
        <p class="collection-lead">把走过的路、见过的光和舍不得丢的纸页收在一处。翻到哪一页，哪一页就是当时。</p>
        <div class="collection-counts"><span><b>{photos.length}</b> 影像</span><span><b>{documents.length}</b> 文档</span></div>
        {dev && <div class="collection-owner-tools"><a class="collection-add-button" href="http://127.0.0.1:4175#record" target="_blank" rel="noreferrer"><span>＋</span><div><b>添一页</b><small>影像 · 纸页 · 小札</small></div></a><a class="collection-add-button collection-layout-button" href="http://127.0.0.1:4175#layout" target="_blank" rel="noreferrer"><span>↔</span><div><b>排画廊</b><small>顺序 · 格幅 · 画幅</small></div></a></div>}
      </div>
      <div class="collection-bouquet" aria-hidden="true">
        <BotanicalSprig variant="lan" />
        <BotanicalSprig variant="ruo" />
        <BotanicalSprig variant="hui" />
        <ChuciGlyph variant="lotus" compact={true} class="collection-chuci-lotus" />
        <i></i><i></i><i></i>
      </div>
    </header>

    <HerbDivider label="光落成页 · photographs" />

    <section class="collection-section" aria-labelledby="photo-gallery-title">
      <div class="collection-section-head"><div><p class="eyebrow">Light & Shadows · 影像谱系</p><h2 id="photo-gallery-title">影像</h2></div><p>行旅记录与光影存证。湖湘晨昏、江流微澜与草木物候。</p></div>
      <div class="collection-gallery">
        {photos.map((item, index) => (
          <figure id={`media-${item.id}`} class={`collection-photo collection-photo-${item.gallerySize || fallbackGallerySizes[index % fallbackGallerySizes.length]} collection-ratio-${galleryRatioOf(item)} collection-photo-${item.display || 'cover'}`}>
            <a
              class="collection-photo-link"
              href={item.src}
              data-lightbox
              data-lightbox-group="collection"
              data-lightbox-src={item.src}
              data-lightbox-title={item.title}
              data-lightbox-desc={item.tags.join(' · ')}
              data-lightbox-meta={formatLibraryDate(item.date)}
              data-lightbox-seal="影"
            >
              <img src={item.thumb || item.src} alt={item.title} loading={index < 4 ? 'eager' : 'lazy'} />
              <span class="collection-photo-index">{String(index + 1).padStart(2, '0')}</span>
              <span class="collection-photo-view">全屏检视</span>
            </a>
            <figcaption><div><b>{item.title}</b><time>{formatLibraryDate(item.date)}</time></div>{item.tags.length > 0 && <span>{item.tags.join(' · ')}</span>}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <HerbDivider label="纸页与附件 · documents" quiet={true} />

    <section class="collection-section document-section" aria-labelledby="document-title">
      <div class="collection-section-head"><div><p class="eyebrow">Manuscripts & Papers · 文献手稿</p><h2 id="document-title">文档</h2></div><p>讲义折页、研究手稿与系统设计附录汇存。</p></div>
      {documents.length ? (
        <div class="document-shelf">
          {documents.map((item, index) => (
            <a class="document-card" href={item.src} target="_blank" rel="noreferrer">
              <span class="document-card-no">D.{String(index + 1).padStart(2, '0')}</span>
              <div class="document-card-mark"><i></i><b>{item.ext || 'FILE'}</b></div>
              <div><h3>{item.title}</h3><p>{formatLibraryDate(item.date)}{item.tags.length ? ` · ${item.tags.join(' / ')}` : ''}</p></div>
              <span class="document-open">查看 ↗</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="document-empty"><BotanicalSprig variant="hui" /><div><strong>册页暂留白</strong><p>待文稿与技术白皮书完成编校后归档入册。</p></div></div>
      )}
    </section>
    <GardenWayfinder current="collection" />
  </div>
</BaseLayout>
  <style>
    .collection-photo{scroll-margin-top:34px;transition:box-shadow .35s ease,background .35s ease}
    .collection-photo:target{background:rgba(125,146,120,.055);box-shadow:0 0 0 1px rgba(63,86,65,.24),0 18px 44px rgba(53,55,42,.07)}
  </style>
</BaseLayout>

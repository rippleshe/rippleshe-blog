---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BotanicalSprig from '../../components/BotanicalSprig.astro';
import HerbDivider from '../../components/HerbDivider.astro';
import GardenWayfinder from '../../components/GardenWayfinder.astro';
import { getCollection } from 'astro:content';
import { libraryItems, formatLibraryDate } from '../../lib/library';
import { gardenUrl, titleOf } from '../../lib/content';
import { publicFolios, folioMemberKey, folioUrl } from '../../lib/folios';

const garden = (await getCollection('garden', ({ data }) => data.publish)).map((entry) => ({
  id: `g-${entry.id}`,
  memberKey: `garden:${entry.id.replace(/\.mdx?$/, '')}`,
  type: '文字' as const,
  title: titleOf(entry),
  date: entry.data.date.toISOString(),
  href: gardenUrl(entry),
  kind: entry.data.kind,
  tags: entry.data.tags,
}));

const media = libraryItems.map((item) => ({
  id: item.id,
  memberKey: `library:${item.id}`,
  type: item.type === 'photo' ? '影像' as const : '文档' as const,
  title: item.title,
  date: item.date,
  href: item.type === 'photo' ? '/collection/#photo-gallery-title' : item.src,
  kind: item.type === 'photo' ? '照片' : item.ext || '文档',
  tags: item.tags,
  thumb: item.thumb,
}));

const covered = new Set(publicFolios.flatMap((folio) => folio.items.map(folioMemberKey)));
const libraryById = new Map(libraryItems.map((item) => [item.id, item]));
const folioItems = publicFolios.map((folio) => {
  const coverRef = folio.items.find((item) => item.source === 'library' && libraryById.get(item.ref)?.type === 'photo');
  const cover = coverRef ? libraryById.get(coverRef.ref) : undefined;
  return {
    id: `f-${folio.id}`,
    memberKey: '',
    type: '册页' as const,
    title: folio.title,
    date: `${folio.date}T12:00:00`,
    href: folioUrl(folio),
    kind: `${folio.items.length} 项`,
    tags: [] as string[],
    thumb: cover?.thumb,
  };
});

const all = [
  ...folioItems,
  ...garden.filter((item) => !covered.has(item.memberKey)),
  ...media.filter((item) => !covered.has(item.memberKey)),
].sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf());
const groups = new Map<string, typeof all>();
for (const item of all) {
  const d = new Date(item.date);
  const key = `${d.getFullYear()} 年 ${String(d.getMonth() + 1).padStart(2, '0')} 月`;
  groups.set(key, [...(groups.get(key) || []), item]);
}
---
<BaseLayout title="日录" description="文字、影像、文档与册页按时间汇成的一条岁时编年。">
  <div class="shell timeline-page">
    <header class="timeline-hero">
      <div>
        <p class="eyebrow">Chronological Flow · 岁序编年</p>
        <h1>日录</h1>
        <p>岁序迁流，篇什、光影与手稿依年月流转汇编入册。自近至远，循迹以溯往昔。</p>
      </div>
      <div class="timeline-clock" aria-label="当前日期">
        <span class="timeline-day" id="timeline-day">--</span>
        <div><b id="timeline-month">--</b><small id="timeline-year">----</small></div>
        <BotanicalSprig variant="ruo" />
      </div>
    </header>

    <HerbDivider label="沿月而下 · newest first" />

    <div class="timeline-filter-bar">
      <span class="timeline-filter-label">TYPE FILTER · 类别过滤</span>
      <div class="timeline-filters">
        <button type="button" class="timeline-type-btn active" data-type="all">全部 ({all.length})</button>
        <button type="button" class="timeline-type-btn" data-type="文字">文字 ({all.filter(i=>i.type==='文字').length})</button>
        <button type="button" class="timeline-type-btn" data-type="影像">影像 ({all.filter(i=>i.type==='影像').length})</button>
        <button type="button" class="timeline-type-btn" data-type="文档">文档 ({all.filter(i=>i.type==='文档').length})</button>
      </div>
    </div>

    <div class="timeline-stream">
      {[...groups.entries()].map(([month, items], monthIndex) => (
        <section class="timeline-month-group" data-month-group>
          <aside><span>{String(monthIndex + 1).padStart(2, '0')}</span><h2>{month}</h2></aside>
          <div class="timeline-items">
            {items.map((item) => (
              <a class={`timeline-entry timeline-entry-${item.type === '影像' ? 'photo' : item.type === '文档' ? 'document' : item.type === '册页' ? 'folio' : 'text'}`} href={item.href} target={item.type === '文档' ? '_blank' : undefined} data-entry-type={item.type}>
                <time>{formatLibraryDate(item.date).slice(5)}</time>
                {'thumb' in item && item.thumb ? <img src={item.thumb} alt="" loading="lazy" /> : <span class="timeline-symbol" aria-hidden="true">{item.type === '文字' ? '文' : item.type === '册页' ? '册' : '纸'}</span>}
                <div><small>{item.type} · {item.kind}</small><h3>{item.title}</h3>{item.tags.length > 0 && <p>{item.tags.join(' · ')}</p>}</div>
                <span class="timeline-arrow">↗</span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>

    <div class="timeline-end">
      <BotanicalSprig variant="lan" />
      <div>
        <strong>岁序周行，日录长新。</strong>
        <p>往昔篇什皆入册，水波流转处，岁月自留痕。</p>
      </div>
      <a class="rule-link" href="/collection/">查看图志藏册 ↗</a>
    </div>
    <GardenWayfinder current="life" />
  </div>
  <script is:inline>
    const now = new Date();
    document.querySelector('#timeline-day').textContent = String(now.getDate()).padStart(2,'0');
    document.querySelector('#timeline-month').textContent = `${String(now.getMonth()+1).padStart(2,'0')} 月`;
    document.querySelector('#timeline-year').textContent = String(now.getFullYear());

    // 类型过滤逻辑
    const typeBtns = document.querySelectorAll('.timeline-type-btn');
    const entries = document.querySelectorAll('.timeline-entry[data-entry-type]');
    const monthGroups = document.querySelectorAll('[data-month-group]');

    typeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        typeBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const filterType = btn.dataset.type;

        entries.forEach(entry => {
          const matched = filterType === 'all' || entry.dataset.entryType === filterType;
          entry.style.display = matched ? '' : 'none';
        });

        monthGroups.forEach(group => {
          const visible = group.querySelector('.timeline-entry:not([style*="display: none"])');
          group.style.display = visible ? '' : 'none';
        });
      });
    });
  </script>

  <style>
    .timeline-filter-bar {
      display: flex;
      align-items: center;
      gap: 16px;
      margin: 20px 0 32px;
      padding: 10px 16px;
      border: 1px solid var(--line);
      background: rgba(248, 245, 237, 0.4);
      flex-wrap: wrap;
    }
    .timeline-filter-label {
      font-size: var(--font-micro);
      color: var(--sage);
      letter-spacing: 0.08em;
    }
    .timeline-filters {
      display: flex;
      gap: 8px;
    }
    .timeline-type-btn {
      background: transparent;
      border: 1px solid var(--line);
      font-size: 11px;
      font-family: var(--sans);
      padding: 3px 10px;
      color: var(--ink-soft);
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .timeline-type-btn.active {
      background: var(--moss);
      color: #fff;
      border-color: var(--moss);
    }
    .timeline-end strong {
      display: block;
      font-family: var(--serif);
      font-size: 17px;
      margin-bottom: 4px;
    }
    .timeline-end p {
      margin: 0;
      font-size: 13px;
      color: var(--ink-soft);
    }
  </style>
</BaseLayout>

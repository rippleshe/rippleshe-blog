---
import BaseLayout from '../layouts/BaseLayout.astro';
import BotanicalSprig from '../components/BotanicalSprig.astro';
import HerbDivider from '../components/HerbDivider.astro';
import PageFolioHeader from '../components/PageFolioHeader.astro';
---
<BaseLayout title="器物录" description="Rippleshe 的生产力工具、软硬件配置与生活器物志。">
  <div class="shell folio-page uses-page-v2">
    <PageFolioHeader
      eyebrow="Uses · 器物志"
      title="器物"
      english="TOOLS, HARDWARE & ENVIRONMENT"
      variant="lan"
      folio="OBJECTS / UTILITIES & HARDWARE"
      intro="工欲善其事，必先利其器。记录长期伴随科研研发、文本写作与日常生活的工具链与器物。"
    />

    <HerbDivider label="常用器物与工具栈 · core tools" />

    <section class="object-cabinet" aria-label="器物分类">
      <article class="object-drawer">
        <span class="object-no">01</span>
        <div><small>COMPUTING & DISPLAY</small><h2>计算与载具</h2><p>高性能计算主机、高色准显示器、机械键盘与静电容输入，构筑高专注工作站。</p></div>
        <i aria-hidden="true">⌁</i>
      </article>
      <article class="object-drawer">
        <span class="object-no">02</span>
        <div><small>SOFTWARE & TOOLCHAIN</small><h2>软件与开发栈</h2><p>VS Code / Neovim、Git、Zsh、Python 科学计算生态与严谨的类型系统。</p></div>
        <i aria-hidden="true">◇</i>
      </article>
      <article class="object-drawer">
        <span class="object-no">03</span>
        <div><small>OPTICS & CAPTURE</small><h2>影像与记录</h2><p>便携微单相机与定焦镜头，以真实光学捕捉湖湘风物与光影质感。</p></div>
        <i aria-hidden="true">○</i>
      </article>
      <article class="object-drawer object-drawer-herb">
        <span class="object-no">04</span>
        <div><small>DESK & ENVIRONMENT</small><h2>文房与案头</h2><p>茶盏、草木盆景与纸质笔记本，于理性代码之侧保留自然触感。</p></div>
        <BotanicalSprig variant="hui" class="object-herb" />
      </article>
    </section>

    <section class="uses-note-card">
      <span class="seal-mark" aria-hidden="true">器</span>
      <div>
        <p class="eyebrow">Axiom · 器物论</p>
        <strong>器以载道，久用成习。</strong>
        <p>不求浮华堆砌，唯选稳定可靠。工具越顺手，越能将精力专注倾注于核心创造。</p>
      </div>
    </section>
  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import HerbDivider from '../components/HerbDivider.astro';
import PageFolioHeader from '../components/PageFolioHeader.astro';
---
<BaseLayout title="履历" description="Rippleshe 的专业工程与学术履历。">
  <div class="shell folio-page resume-page-v2">
    <PageFolioHeader
      eyebrow="Resume · 个人履历"
      title="履历"
      english="ACADEMIC BACKGROUND & ENGINEERING SYSTEMS"
      variant="ruo"
      folio="CURRICULUM VITAE / RIPPLESHE"
      intro="学术研究、工程系统研制与核心专业能力的结构化汇编。"
    />

    <HerbDivider label="专业履历 · curriculum vitae" />

    <section class="resume-fold" aria-label="履历结构">
      <aside class="resume-sidebar">
        <div class="resume-monogram">R / S</div>
        <dl>
          <div><dt>NAME</dt><dd>Ripple She (佘)</dd></div>
          <div><dt>FOCUS</dt><dd>Data Visualization · Distributed Systems · Multi-Agent RL</dd></div>
          <div><dt>LOCATION</dt><dd>Hunan, China</dd></div>
          <div><dt>STATUS</dt><dd>Active Research & Development</dd></div>
        </dl>
      </aside>

      <div class="resume-main">
        <section class="resume-section">
          <span class="resume-section-no">01</span>
          <div>
            <small>RESEARCH & ENGINEERING PROFILE</small>
            <h2>专业方向与研究定位</h2>
            <p>专注于科研数据可视化标准、跨平台系统工具及多智能体强化学习算法。坚持精炼的工程原则，追求底层透明性、代码可维护性与学术级出版精度。</p>
          </div>
        </section>

        <section class="resume-section">
          <span class="resume-section-no">02</span>
          <div>
            <small>CORE SYSTEMS & ARTIFACTS</small>
            <h2>核心系统与研制成果</h2>
            <ul class="resume-works-list">
              <li>
                <strong>SciPlot Academic</strong>
                <span>面向 Nature、IEEE、Science 规范的学术级科研绘图系统，内置 45+ 经典图表家族。</span>
              </li>
              <li>
                <strong>PanView</strong>
                <span>跨平台多源文档排版引擎与可视化交互桌面应用，深度协同 LaTeX 与学术排版流。</span>
              </li>
              <li>
                <strong>NeteaseDL</strong>
                <span>轻量化高性能流媒体音频协议解析与自动化 ID3 元数据处理工具套件。</span>
              </li>
              <li>
                <strong>IM Training Agent</strong>
                <span>面向交互决策的强化学习多智能体协同框架，支持策略博弈与可解释性分析。</span>
              </li>
            </ul>
            <a class="rule-link" href="/works/">查看造物专页 ↗</a>
          </div>
        </section>

        <section class="resume-section">
          <span class="resume-section-no">03</span>
          <div>
            <small>TECHNICAL STACK & METHODOLOGY</small>
            <h2>技术栈与专业技能</h2>
            <div class="resume-skills-grid">
              <div>
                <strong>编程语言与核心库</strong>
                <p>Python (PyTorch, NumPy, Pandas, Matplotlib), TypeScript / JavaScript, Rust, C/C++</p>
              </div>
              <div>
                <strong>数据与可视化</strong>
                <p>Publication-Ready Visualization, Vector Graphics (SVG/PDF), Statistical Inference, EDA</p>
              </div>
              <div>
                <strong>系统架构与基础设施</strong>
                <p>Edge Computing (Tencent EdgeOne), PostgreSQL, CloudBase RPC, Git, Docker, Astro SSG</p>
              </div>
              <div>
                <strong>算法与研究方法</strong>
                <p>Multi-Agent Reinforcement Learning, Decision Optimization, Formal Experimentation</p>
              </div>
            </div>
          </div>
        </section>
      </div>
    </section>

    <section class="resume-print-note">
      <div class="print-note-content">
        <span>PROFESSIONAL CONTACT</span>
        <p>如需探讨学术研究合作、系统工程交流或技术咨询，欢迎通过 GitHub @rippleshe 取得联络。</p>
      </div>
      <button type="button" class="resume-print-action-btn" id="resume-print-btn">
        <span>🖨 打印或导出为标准 PDF 简历</span>
      </button>
    </section>
  </div>

  <script is:inline>
    document.getElementById('resume-print-btn')?.addEventListener('click', () => {
      window.print();
    });
  </script>
</BaseLayout>

<style>
  .resume-works-list {
    list-style: none;
    padding: 0;
    margin: 12px 0 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .resume-works-list li {
    padding-left: 12px;
    border-left: 2px solid var(--moss);
  }
  .resume-works-list strong {
    display: block;
    font-size: 14px;
    font-family: var(--serif);
    color: var(--ink);
  }
  .resume-works-list span {
    font-size: 12px;
    color: var(--ink);
    opacity: 0.8;
  }
  .resume-skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-top: 12px;
  }
  .resume-skills-grid strong {
    display: block;
    font-size: 13px;
    color: var(--moss);
    margin-bottom: 4px;
  }
  .resume-skills-grid p {
    font-size: 12px;
    line-height: 1.5;
    margin: 0;
    opacity: 0.85;
  }
  .resume-print-note {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .resume-print-action-btn {
    background: transparent;
    border: 1px solid var(--line-strong);
    color: var(--moss);
    font-size: 12px;
    font-family: var(--sans);
    padding: 6px 14px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .resume-print-action-btn:hover {
    background: var(--moss);
    color: #fff;
  }

  @media print {
    @page {
      size: A4;
      margin: 15mm 20mm;
    }
    :global(body) {
      background: #fff !important;
      color: #000 !important;
    }
    :global(.site-header),
    :global(.site-footer),
    :global(.site-ripple-layer),
    :global(.herb-divider),
    :global(.resume-print-action-btn) {
      display: none !important;
    }
    .resume-page-v2 {
      padding: 0 !important;
      max-width: 100% !important;
    }
    .resume-section {
      break-inside: avoid;
    }
  }

  @media (max-width: 640px) {
    .resume-skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
